<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent registered by SMAppService (see FeedsService.swift).
     Keeps `CodeSaver --feeds` alive: the widget feed daemon that merges
     Claude Code hook state + bifrocate CoT spools + now-playing into
     widgets/feed.json in the app-group container. Cheap by construction
     (a 1s merge over tiny files, ~4% of a core) — and run at STANDARD
     priority on purpose: as a Background/nice/low-I/O job it was starved
     outright whenever normal-priority work saturated the machine (one
     publish in 45 s at load 130), the feed went stale, and the saver
     dropped every panel. The corpus refresh agent stays Background; this
     one has a 20-second deadline to meet every second. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.michelg10.CodeSaver.feeds</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/CodeSaver</string>
	<key>ProgramArguments</key>
	<array>
		<string>CodeSaver</string>
		<string>--feeds</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.michelg10.CodeSaver</string>
	</array>
</dict>
</plist>
