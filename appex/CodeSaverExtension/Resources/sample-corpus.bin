//
//  Host application for the screensaver extension. The host app exists so the
//  .appex can be bundled and registered with pluginkit; macOS does not load
//  appex bundles that aren't embedded inside an application.
//

import SwiftUI
import PaperSaverKit

struct CodeSaverApp: App {
    /// Fire one trivial Apple Event at each running player from the host
    /// app's UI context. The background daemon can never show the Automation
    /// consent dialog (silently denied, no prompt, no TCC record), so the
    /// app asks on the bundle's behalf; one approval covers the daemon too.
    static func seedAutomationConsent() {
        let logURL = FileManager.default.homeDirectoryForCurrentUser
            .appendingPathComponent(".claude/codesaver/consent-probe.log")
        var lines = ["probe @ \(Date()) pid \(ProcessInfo.processInfo.processIdentifier) ui"]
        for p in FeedsService.players {
            guard !NSRunningApplication.runningApplications(
                withBundleIdentifier: p.bundle).isEmpty else {
                lines.append("\(p.name): not running"); continue
            }
            var err: NSDictionary?
            let out = NSAppleScript(source: "tell application \"\(p.name)\" to get player state")?
                .executeAndReturnError(&err)
            lines.append("\(p.name): result=\(out?.stringValue ?? "nil") "
                + "err=\(err.map { String(describing: $0) } ?? "none")")
        }
        try? (lines.joined(separator: "\n") + "\n")
            .write(to: logURL, atomically: true, encoding: .utf8)
    }

    init() {
        // A real UI launch: seed the music Automation consent from
        // foreground context — the background feeds daemon can never show
        // the prompt itself. One approval covers the bundle id for good.
        DispatchQueue.main.asyncAfter(deadline: .now() + 1.5) {
            CodeSaverApp.seedAutomationConsent()
        }
    }

    var body: some Scene {
        WindowGroup {
            ContentView()
        }
        .windowStyle(.hiddenTitleBar)
        .windowResizability(.contentSize)

        Window("Album art", id: "albumart") {
            AlbumArtTunerView()
        }
        .defaultSize(width: 1060, height: 720)

        Window("Preview", id: "preview") {
            PreviewViewRepresentable()
                .ignoresSafeArea()
        }
        .defaultSize(width: 640, height: 480)
    }
}
    var body: some View {
        VStack(spacing: 0) {
            hero
            Rectangle().fill(Theme.hairline).frame(height: 1)
            VStack(alignment: .leading, spacing: 16) {
                eyebrow("SETUP")
                setupRows
                Rectangle().fill(Theme.hairline).frame(height: 1)
                eyebrow("CORPUS")
                corpusRow
                Rectangle().fill(Theme.hairline).frame(height: 1)
                eyebrow("IGNITION")
                ignitionRows
                if let error = firstError {
                    Text(error)
                        .font(Theme.mono(11))
                        .foregroundStyle(Theme.alert)
                        .textSelection(.enabled)
                }
                advanced
            }
            .padding(22)
        }
        .frame(width: 480)
        .background(.black)
        .preferredColorScheme(.dark)
        .tint(Theme.violet)
        .onReceive(NotificationCenter.default.publisher(
            for: NSApplication.didBecomeActiveNotification)) { _ in
            pluginManager.checkInstallationStatus()
            pluginManager.checkScreensaverStatus()
            refreshManager.reload()
            igniterState = Self.probeIgniter()
            igniterDenied = Self.igniterScreenRecordingDenied()
            albumArtStyle = Self.loadAlbumArtStyle()
        }
        // The tuning window writes the same key (picking a style there
        // selects it); re-read rather than show a value seeded at init.
        .onReceive(NotificationCenter.default.publisher(
            for: .albumArtStyleDidChange)) { _ in
            albumArtStyle = Self.loadAlbumArtStyle()
        }
        .onAppear {
            igniterState = Self.probeIgniter()
            igniterDenied = Self.igniterScreenRecordingDenied()
        }
        .fileImporter(isPresented: $showVerbsImporter,
                      allowedContentTypes: [.text, .tabSeparatedText]) { result in
            if case .success(let url) = result {
                refreshManager.importVerbs(from: url)
            }
        }
    }

    // MARK: Hero

    private var hero: some View {
        HeroSaver()
            .frame(width: 480, height: 220)
            .clipped()
            .allowsHitTesting(false)
            .ignoresSafeArea(edges: .top)  // bleed under the hidden title bar
            .overlay(alignment: .bottom) {
                LinearGradient(colors: [.clear, .black.opacity(0.9)],
                               startPoint: .top, endPoint: .bottom)
                    .frame(height: 90)
            }
            .overlay(alignment: .bottom) {
                HStack(alignment: .firstTextBaseline) {
                    Text("✽ CodeSaver")
                        .font(Theme.mono(16, .semibold))
                        .foregroundStyle(Theme.ink)
                        .shadow(color: Theme.violet.opacity(0.9), radius: 8)
                    Spacer()
                    Text(extensionStatusLine)
                        .font(Theme.mono(10))
                        .foregroundStyle(Theme.slate)
                }
                .padding(.horizontal, 18)
                .padding(.bottom, 12)
            }
    }

    private var extensionStatusLine: String {
        if pluginManager.isInstalled {
            let version = pluginManager.installedVersion.map { " v\($0)" } ?? ""
            return "appex\(version) registered"
        }
        return "appex not registered yet"
    }
            // 3 — the refresh agent
            let agentState = state(of: 2, done: agentDone)
            HStack(spacing: 10) {
                glyph(agentState)
                stepTitle("Auto-refresh", agentState)
                Text("daily · plugged in · lowest priority")
                    .font(Theme.mono(10)).foregroundStyle(Theme.dim)
                Spacer()
                Toggle("", isOn: Binding(get: { refreshManager.agentEnabled },
                                         set: { refreshManager.setAutoRefresh($0) }))
                    .toggleStyle(.switch)
                    .controlSize(.mini)
                    .labelsHidden()
                    .disabled(!tokenDone)
            }
            if refreshManager.agentNeedsApproval {
                approvalRow
            }

            // 4 — the widget feed daemon: its own LaunchAgent, its own
            // switch. Optional — the saver is whole without it — so nothing
            // gates it and nothing else turns it on.
            let feedsState = state(of: 3, done: feedsDone)
            HStack(spacing: 10) {
                glyph(feedsState)
                stepTitle("Live widgets", feedsState)
                Text("optional · Claude Code sessions · now playing")
                    .font(Theme.mono(10)).foregroundStyle(Theme.dim)
                Spacer()
                Toggle("", isOn: Binding(get: { refreshManager.feedsEnabled },
                                         set: { refreshManager.setLiveWidgets($0) }))
                    .toggleStyle(.switch)
                    .controlSize(.mini)
                    .labelsHidden()
            }
            if refreshManager.feedsNeedsApproval {
                approvalRow
            }
            Text(liveWidgetsCaption)
                .font(Theme.mono(10))
                .foregroundStyle(Theme.dim)
                .fixedSize(horizontal: false, vertical: true)
                .padding(.leading, 24)
        }
    }

    /// Both agents wait on the same Login Items approval when macOS asks.
    private var approvalRow: some View {
        HStack(spacing: 8) {
            Text("waiting for approval in Login Items")
                .font(Theme.mono(11)).foregroundStyle(Theme.alert)
            Button("Open Login Items") { refreshManager.openLoginItems() }
                .buttonStyle(.bordered)
                .controlSize(.small)
        }
        .padding(.leading, 24)
    }

    private var liveWidgetsCaption: String {
        "sessions need Claude Code's hooks: python3 feeds/wire-settings.py — state lands in ~/.claude/codesaver/sessions"
        + "\nnow playing reads Music or Spotify; macOS asks for consent when this window opens"
        + "\nthe pause + pin mods are optional — without them the panels follow hook state alone"
    }

    // MARK: Corpus

    private var corpusRow: some View {
        HStack(alignment: .firstTextBaseline, spacing: 10) {
            if refreshManager.isRefreshing {
                Text("✽").font(Theme.mono(13)).foregroundStyle(Theme.violetHot)
                    .shadow(color: Theme.violet.opacity(0.9), radius: 5)
                Text(refreshManager.progressText ?? "working…")
                    .font(Theme.mono(12)).foregroundStyle(Theme.ink)
            } else if refreshManager.state.lastSuccess != nil {
                Text("✻").font(Theme.mono(13)).foregroundStyle(Theme.slate)
                Text("\(refreshManager.state.fileCount.formatted()) files · \(refreshManager.state.repoCount) repos · \(refreshManager.corpusSizeDescription) · \(refreshManager.lastRefreshDescription)
                    .font(Theme.mono(12)).foregroundStyle(Theme.ink)
            } else {
                Text("·").font(Theme.mono(13)).foregroundStyle(Theme.dim)
                Text("no corpus yet — the first refresh builds it")
                    .font(Theme.mono(12)).foregroundStyle(Theme.slate)
            }
            Spacer()
            Button("Refresh Now") { refreshManager.refreshNow() }
                .buttonStyle(.bordered)
                .controlSize(.small)
                .disabled(refreshManager.isRefreshing || !tokenDone)
        }
    }
    private var ignitionRows: some View {
        VStack(alignment: .leading, spacing: 12) {
            if igniterState != .running {
                let (headline, command) = igniterState == .missing
                    ? ("igniter not installed — these triggers are dormant",
                       "./build.sh && ./helper/install.sh")
                    : ("igniter installed but not running — these triggers are dormant",
                HStack(alignment: .firstTextBaseline, spacing: 10) {
                    Text("✽").font(Theme.mono(13)).foregroundStyle(Theme.alert)
                        .shadow(color: Theme.alert.opacity(0.9), radius: 5)
                    VStack(alignment: .leading, spacing: 3) {
                        Text(headline)
                            .font(Theme.mono(12, .semibold)).foregroundStyle(Theme.alert)
                        Text("\(command) — settings below stick either way")
                            .font(Theme.mono(10)).foregroundStyle(Theme.slate)
                            .textSelection(.enabled)
                    }
                    Spacer()
                    Button("Copy") {
                        NSPasteboard.general.clearContents()
                        NSPasteboard.general.setString(command, forType: .string)
                    }
                    .buttonStyle(.bordered).controlSize(.small)
                }
            }
            if igniterState == .running, igniterDenied {
                HStack(alignment: .firstTextBaseline, spacing: 10) {
                    Text("✽").font(Theme.mono(13)).foregroundStyle(Theme.alert)
                        .shadow(color: Theme.alert.opacity(0.9), radius: 5)
                    Text("no Screen Recording grant — the saver starts plain, no boom · System Settings › Privacy & Security › Screen Recording › CodeSaverIgniter")
                        .font(Theme.mono(11)).foregroundStyle(Theme.alert)
                        .fixedSize(horizontal: false, vertical: true)
                    Spacer()
                    Button("Open") { openScreenRecordingSettings() }
                        .buttonStyle(.bordered).controlSize(.small)
                }
            }
            HStack(spacing: 8) {
                Text("idle").font(Theme.mono(11)).foregroundStyle(Theme.slate)
                Picker("", selection: Binding(
                    get: { idleTimeout },
                    set: { idleTimeout = $0; igniterDefaults?.set($0, forKey: "idleTimeout") })) {
                    Text("use macOS setting").tag(0)
                    Text("after 1 minute").tag(60)
                    Text("after 2 minutes").tag(120)
                    Text("after 5 minutes").tag(300)
                    Text("after 10 minutes").tag(600)
                    Text("after 15 minutes").tag(900)
                    Text("after 30 minutes").tag(1800)
                }
                .pickerStyle(.menu)
                .labelsHidden()
                .controlSize(.small)
                .frame(width: 180, alignment: .leading)
            }
            HStack(alignment: .top, spacing: 8) {
                Text("corners").font(Theme.mono(11)).foregroundStyle(Theme.slate)
                    .padding(.top, 3)
                Grid(alignment: .leading, horizontalSpacing: 10, verticalSpacing: 6) {
                    GridRow {
                        cornerPicker("◸", "cornerTL", $cornerTL)
                        cornerPicker("◹", "cornerTR", $cornerTR)
                    }
                    GridRow {
                        cornerPicker("◺", "cornerBL", $cornerBL)
                        cornerPicker("◿", "cornerBR", $cornerBR)
                    }
                }
            }
            Text(ignitionCaption)
                .font(Theme.mono(10))
                .foregroundStyle(Theme.dim)
                .fixedSize(horizontal: false, vertical: true)
        }
    }

    private func cornerPicker(_ glyph: String, _ key: String,
                              _ state: Binding<Int>) -> some View {
        HStack(spacing: 5) {
            Text(glyph).font(Theme.mono(11)).foregroundStyle(Theme.slate)
            Picker("", selection: Binding(
                get: { state.wrappedValue },
                set: { state.wrappedValue = $0; igniterDefaults?.set($0, forKey: key) })) {
                Text("off").tag(0)
                Text("instant").tag(1)
                Text("⌘ hold").tag(3)
                Text("⌥ hold").tag(5)
                Text("⌃ hold").tag(9)
                Text("⇧ hold").tag(17)
            }
            .pickerStyle(.menu)
            .labelsHidden()
            .controlSize(.small)
            .frame(width: 108, alignment: .leading)
        }
    }
    private var advancedRows: some View {
        VStack(alignment: .leading, spacing: 12) {
                HStack(spacing: 8) {
                    Text("repos of").font(Theme.mono(11)).foregroundStyle(Theme.slate)
                    TextField("token's account", text: $refreshManager.owner)
                        .textFieldStyle(.roundedBorder)
                        .font(Theme.mono(11))
                        .frame(width: 170)
                        .onSubmit { refreshManager.saveOwner() }
                }
                HStack(spacing: 8) {
                    Text("verbs").font(Theme.mono(11)).foregroundStyle(Theme.slate)
                    Text(refreshManager.customVerbCount.map { "custom list (\($0))" } ?? "bundled list")
                        .font(Theme.mono(11)).foregroundStyle(Theme.ink)
                    Button("Import…") { showVerbsImporter = true }
                        .buttonStyle(.bordered).controlSize(.small)
                    if refreshManager.customVerbCount != nil {
                        Button("Use bundled") { refreshManager.resetVerbs() }
                            .buttonStyle(.bordered).controlSize(.small)
                    }
                }
                HStack(spacing: 8) {
                    Text("album art").font(Theme.mono(11)).foregroundStyle(Theme.slate)
                    Picker("", selection: Binding(
                        get: { albumArtStyle },
                        set: { albumArtStyle = $0; ContentView.saveAlbumArtStyle($0) })) {
                        Text("off").tag("none")
                        Text("on").tag("ramp")
                    }
                    .pickerStyle(.segmented)
                    .labelsHidden()
                    .controlSize(.small)
                    .frame(width: 140, alignment: .leading)
                    Button("Tune…") { openWindow(id: "albumart") }
                        .buttonStyle(.bordered).controlSize(.small)
                }
                HStack(spacing: 16) {
                    Button("Preview window") { openWindow(id: "preview") }
                    Button("Screen Saver settings") { openScreenSaverSettings() }
                    if tokenDone {
                        Button("Forget token") { refreshManager.forgetToken() }
                    }
                }
                .buttonStyle(.link)
                .font(Theme.mono(11))
            }
    }

    // MARK: Helpers

    private func eyebrow(_ text: String) -> some View {
        Text(text)
            .font(Theme.mono(10, .semibold))
            .tracking(3)
            .foregroundStyle(Theme.dim)
    }

    private func openScreenSaverSettings() {
        if let url = URL(string: "x-apple.systempreferences:com.apple.ScreenSaver-Settings.extension") {
            NSWorkspace.shared.open(url)
        }
    }

    private func openScreenRecordingSettings() {
        if let url = URL(string: "x-apple.systempreferences:com.apple.preference.security?Privacy_ScreenCapture") {
            NSWorkspace.shared.open(url)
        }
    }
}

/// Type-erased button style so a button can switch prominence with state.
private struct AnyButtonStyle: PrimitiveButtonStyle {
    private let apply: (Configuration) -> AnyView

    init(_ style: some PrimitiveButtonStyle) {
        apply = { AnyView(Button($0).buttonStyle(style)) }
    }

    func makeBody(configuration: Configuration) -> some View {
        apply(configuration)
    }
}

#Preview {
    ContentView()
}
//
//  CorpusStore.swift
//  CodeSaver
//
//  Shared corpus location + refresh state. Compiled into the host app, the
//  sandboxed appex, AND the standalone swiftc builds in build.sh — keep this
//  file Foundation-only.
//

import Foundation

enum CorpusStore {
    /// in Info.plist (CodeSaverAppGroup, substituted from DEVELOPMENT_TEAM at
    /// build time, matching both entitlements files) so forks need zero edits.
    /// The bare-swiftc preview harness has no bundle and falls back to the
    /// stock team's literal.
    static let appGroupID: String = {
        if let fromPlist = Bundle.main.object(forInfoDictionaryKey: "CodeSaverAppGroup") as? String,
           !fromPlist.isEmpty, !fromPlist.hasPrefix(".") {  // "." = DEVELOPMENT_TEAM was unset
            return fromPlist
        }
    }()

    /// The shared app-group container. The sandboxed appex can only reach the
    /// corpus through this API — never hand-build the path there. The
    /// unsandboxed app and preview harness resolve to the same
    /// ~/Library/Group Containers URL.
    static var containerURL: URL? {
        FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: appGroupID)
    }

    /// corpus.bin / corpus-index.json / state.json live here.
    static var corpusDirectory: URL? {
        containerURL?.appendingPathComponent("Library/Application Support/CodeSaver",
                                             isDirectory: true)
    }

    /// widgets/ under the corpus: the feed, album art and settings the saver's
    /// panels read and the feeds daemon writes. CODESAVER_WIDGETS_DIR points
    /// the snapshot harness at a fixture directory instead, so a rendered
    /// frame can show a chosen panel state rather than whatever is playing.
    static var widgetsDirectory: URL? {
        if let p = ProcessInfo.processInfo.environment["CODESAVER_WIDGETS_DIR"], !p.isEmpty {
            return URL(fileURLWithPath: p, isDirectory: true)
        }
        return corpusDirectory?.appendingPathComponent("widgets", isDirectory: true)
    }

    /// Per-repo filtered mirror of GitHub (what ingest/cache/ used to be).
    static var repoCacheDirectory: URL? {
        containerURL?.appendingPathComponent("Library/Caches/CodeSaver/cache", isDirectory: true)
    }

    /// Download + extraction scratch; deleted after every refresh.
    static var scratchDirectory: URL? {
        containerURL?.appendingPathComponent("Library/Caches/CodeSaver/tmp", isDirectory: true)
    }

    static var corpusExists: Bool {
        guard let dir = corpusDirectory else { return false }
        return FileManager.default.fileExists(atPath: dir.appendingPathComponent("corpus.bin").path)
    }

    /// User-supplied spinner verbs ("Gerund<TAB>Past" per line). Lives in the same
    /// directory the corpus does, so the saver's resource-dir chain prefers it
    /// over the bundled list automatically.
    static var verbsURL: URL? { corpusDirectory?.appendingPathComponent("spinner-verbs.txt") }

    // MARK: State

    struct State: Codable {
        var lastSuccess: Date?
        var lastError: String?
        var repoPushedAt: [String: String] = [:]   // manifest: repo → pushed_at
        var repoCount = 0
        var fileCount = 0
        var corpusBytes = 0
    }

    static var stateURL: URL? { corpusDirectory?.appendingPathComponent("state.json") }

    static func loadState() -> State {
        guard let url = stateURL, let data = try? Data(contentsOf: url) else { return State() }
        let decoder = JSONDecoder()
        decoder.dateDecodingStrategy = .iso8601
        return (try? decoder.decode(State.self, from: data)) ?? State()
    }
    static func saveState(_ state: State) {
        guard let url = stateURL else { return }
        try? FileManager.default.createDirectory(at: url.deletingLastPathComponent(),
                                                 withIntermediateDirectories: true)
        let encoder = JSONEncoder()
        encoder.dateEncodingStrategy = .iso8601
        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
        if let data = try? encoder.encode(state) {
            try? data.write(to: url, options: .atomic)
        }
    }

    /// Atomic replace via rename(2): readers see the old file or the new one,
    /// never a torn write, and in-flight screensaver sessions keep their mmap
    /// of the old inode.
    static func replaceFile(at dest: URL, with source: URL) throws {
        try source.withUnsafeFileSystemRepresentation { src in
            try dest.withUnsafeFileSystemRepresentation { dst in
                guard let src, let dst else { throw POSIXError(.EINVAL) }
                guard rename(src, dst) == 0 else {
                    throw POSIXError(POSIXErrorCode(rawValue: errno) ?? .EIO)
                }
            }
        }
    }

    // MARK: Cross-process refresh lock

    /// The app's "Refresh Now" and the `--refresh` LaunchAgent are separate
    /// processes sharing one scratch dir, one repo cache and one pair of
    /// corpus tmp files; nothing in-process can serialize them. An advisory
    /// flock(2) on this file does, and the kernel drops it if the holder dies.
    static var refreshLockURL: URL? { corpusDirectory?.appendingPathComponent(".refresh.lock") }

    /// Held for as long as the token lives, or until `release()`.
    final class RefreshLock: @unchecked Sendable {
        private var fd: Int32
        fileprivate init(fd: Int32) { self.fd = fd }
        deinit { release() }
        func release() {
            guard fd >= 0 else { return }
            flock(fd, LOCK_UN)
            close(fd)
            fd = -1
        }
    }

    /// nil = another process holds the lock (a refresh is mid-flight there).
    /// Throws only when the lock file itself can't be opened.
    static func tryLockRefresh() throws -> RefreshLock? {
        guard let url = refreshLockURL else { throw POSIXError(.ENOENT) }
        try FileManager.default.createDirectory(at: url.deletingLastPathComponent(),
                                                withIntermediateDirectories: true)
        let fd = open(url.path, O_RDWR | O_CREAT | O_CLOEXEC, 0o644)  // CLOEXEC: tar must not inherit it
        guard fd >= 0 else { throw POSIXError(POSIXErrorCode(rawValue: errno) ?? .EIO) }
        guard flock(fd, LOCK_EX | LOCK_NB) == 0 else {
            let err = errno
            close(fd)
            if err == EWOULDBLOCK { return nil }
            throw POSIXError(POSIXErrorCode(rawValue: err) ?? .EIO)
        }
        return RefreshLock(fd: fd)
    }
}
    /// Downloads the repo tarball to a temp file (URLSession follows the
    /// codeload redirect and streams to disk — constant memory).
    func downloadTarball(owner: String, repo: String) async throws -> URL {
        let (tmp, resp) = try await URLSession.shared.download(
            for: request("https://api.github.com/repos/\(owner)/\(repo)/tarball"))
        guard let http = resp as? HTTPURLResponse, (200..<300).contains(http.statusCode) else {
            try? FileManager.default.removeItem(at: tmp)
            throw FetchError.http((resp as? HTTPURLResponse)?.statusCode ?? -1, "tarball \(repo)")
        }
        return tmp
    }
}

// MARK: - Filtering + corpus packing (ports of ingest.py / make_corpus.py)

enum CorpusIngest {
    static let allowedExtensions: Set<String> = [
        "swift", "py", "js", "jsx", "ts", "tsx", "c", "cc", "cpp", "h", "hpp",
        "m", "mm", "rs", "go", "java", "kt", "rb", "sh", "zsh", "css", "scss",
        "html", "vue", "svelte", "sql", "metal", "cu", "hs", "ml", "lua", "jl",
    ]
    static let skipDirs: Set<String> = [
        "node_modules", ".git", "build", "dist", ".build", "Pods", "vendor", "venv",
        ".venv", "__pycache__", "DerivedData", ".next", "target", "out", ".cache",
    ]
    static let generatedPatterns = [
        "*.min.js", "*.min.css", "*_pb2.py", "*.pb.go", "*.pb.cc", "*.pb.h",
        "*.generated.*", "*.g.dart", "*.bundle.js", "*.map",
    ]
    static let minSize = 64, maxSize = 200_000
    static let maxDirFiles = 150              // more source files than this in one dir → vendored/generated
    static let maxRepoBytes = 200 * 1024 * 1024
    static let maxTarballBytes = 300 * 1024 * 1024
    static let maxLineLength = 200
    static let minLines = 4
    static let maxSecretHits = 3              // a file this secret-dense is dropped entirely

    // This text renders on an always-visible screen, so scrub aggressively —
    // a false positive only blanks one line of screensaver background.
    static let secretRegexes: [NSRegularExpression] = {
        let patterns: [(String, NSRegularExpression.Options)] = [
            // key-ish identifier (with any tail, so password/SECRET_KEY/aws_access_key_id
            // all match) directly assigned — bare (API_KEY = …), or quoted /
            // subscripted the way dict, JSON and header literals spell it
            // ("api_key": …, 'password': …, config["token"] = …)
            //
            // The punctuation classes carry the FULLWIDTH forms too. CJK source
            // is written with them — `api_key ："…"`, `密钥＝"…"`, 「token」 for
            // quotes — and an ASCII-only [:=] walked straight past every one of
            // those, leaving the literal on screen. Same reason the identifier
            // list names the words a Chinese, Japanese or Korean codebase
            // actually uses; `\w` is already Unicode-aware in ICU, so the tail
            // matches 密钥_测试 as happily as api_key_test. A false positive
            // still only blanks one line of screensaver background.
            ("(api[_-]?key|passw|passwd|pwd|secret|token|credential"
             + "|private[_-]?key|access[_-]?key|signing[_-]?key|auth"
             + "|密码|密碼|密钥|密鑰|口令|令牌|秘密|凭证|憑證"
             + "|パスワード|トークン|秘密鍵|認証"
             + "|비밀번호|암호|토큰|인증)"
             + "[\\w-]*[\\s\"'\\]”’」』）］]*[:=：＝]", [.caseInsensitive]),
            // value-shaped: known token prefixes, JWTs, creds-in-URL
            ("AKIA[0-9A-Z]{16}", []),
            ("\\bghp_[A-Za-z0-9]{20,}|\\bgithub_pat_[A-Za-z0-9_]{20,}", []),
            ("\\bsk-[A-Za-z0-9_-]{20,}", []),
            ("\\bxox[baprs]-[A-Za-z0-9-]{10,}", []),
            ("\\bAIza[0-9A-Za-z_-]{30,}", []),
            ("\\beyJ[A-Za-z0-9_-]{10,}\\.", []),
            ("://[^/\\s:]+:[^@\\s]+@", []),
        ]
        return patterns.map { try! NSRegularExpression(pattern: $0.0, options: $0.1) }
    }()
    static let pemRegex = try! NSRegularExpression(pattern: "-----BEGIN [A-Z ]*PRIVATE KEY-----")

    /// Cc/Cf/illegal, MINUS the two zero-width joiners. `controlCharacters` is
    /// Cc *and Cf*, and U+200D ZWJ is Cf: stripping it shattered every ZWJ
    /// emoji sequence into its pieces (👨‍👩‍👧‍👦 became four glyphs, four cells
    /// wide instead of two) and broke ZWNJ-dependent scripts. Everything else
    /// Cf still goes — BOM, bidi overrides, the invisible separators a
    /// screensaver must never render.
    private static let unprintable = CharacterSet.controlCharacters
        .union(.newlines).union(.illegalCharacters)
        .subtracting(CharacterSet(charactersIn: "\u{200C}\u{200D}"))

    static func wanted(relPath: String, size: Int) -> Bool {
        let parts = relPath.split(separator: "/").map(String.init)
        guard let name = parts.last else { return false }
        if parts.dropLast().contains(where: { skipDirs.contains($0) || $0.hasPrefix(".") }) {
            return false
        }
        if generatedPatterns.contains(where: { fnmatch($0, name, 0) == 0 }) { return false }
        guard allowedExtensions.contains((name as NSString).pathExtension.lowercased()) else {
            return false
        }
        return size > minSize && size < maxSize
    }
    /// Cells one character occupies in a terminal — 2 for East Asian Wide and
    /// Fullwidth (UAX #11 W/F) and for emoji presentation, 1 otherwise. There
    /// is no East-Asian-Width in `Unicode.Scalar.Properties`, and this file
    /// runs with no font loaded, so it classifies by scalar range. The saver's
    /// renderer measures the real glyph instead; the two agree on everything
    /// that matters here (tab stops), and this side never needs to be exact —
    /// only to stop counting 漢 as one column.
    static func cells(_ ch: Character) -> Int {
        guard let u = ch.unicodeScalars.first, u.value >= 0x1100 else { return 1 }
        switch u.value {
        case 0x1100...0x115F,            // Hangul Jamo initial
             0x2E80...0x303E,            // CJK radicals, Kangxi, CJK symbols
             0x3041...0x33FF,            // kana, Hangul compat jamo, CJK compat
             0x3400...0x4DBF,            // CJK ext A
             0x4E00...0x9FFF,            // CJK unified
             0xA000...0xA4CF,            // Yi
             0xAC00...0xD7A3,            // Hangul syllables
             0xF900...0xFAFF,            // CJK compat ideographs
             0xFE10...0xFE19,            // vertical forms
             0xFE30...0xFE6F,            // CJK compat forms, small forms
             0xFF00...0xFF60,            // fullwidth forms
             0xFFE0...0xFFE6,            // fullwidth signs
             0x1F300...0x1F64F,          // emoji
             0x1F900...0x1F9FF,
             0x20000...0x3FFFD:          // CJK ext B+
            return 2
        default:
            return 1
        }
    }

    /// Tab stops the way the author's editor set them: a wide character
    /// advances the column by two. Counting every character as one column put
    /// the stops in the wrong place for every CJK-bearing line, so indentation
    /// that lined up in the repo arrived ragged.
    private static func expandTabs(_ s: some StringProtocol, width: Int = 4) -> String {
        guard s.contains("\t") else { return String(s) }
        var out = ""
        var col = 0
        for ch in s {
            if ch == "\t" {
                let pad = width - (col % width)
                out += String(repeating: " ", count: pad)
                col += pad
            } else {
                out.append(ch)
                col += cells(ch)
            }
        }
        return out
    }

    private static func matches(_ regex: NSRegularExpression, _ line: String) -> Bool {
        regex.firstMatch(in: line, range: NSRange(line.startIndex..., in: line)) != nil
    }

    /// A source file's text, or nil when nothing can read it confidently.
    ///
    /// `String(decoding:as: UTF8.self)` NEVER fails — it substitutes U+FFFD
    /// for every byte it can't parse — so a Shift-JIS or GB18030 source (still
    /// common in CJK repos) used to be packed into the corpus as a solid wall
    /// of replacement characters and typed across the screen as ����. It also
    /// sailed through every filter below, U+FFFD being a perfectly printable
    /// character.
    ///
    /// So: decode strictly, and only then guess. The guess is Foundation's own
    /// detector (what TextEdit's "guess encoding" runs) — the legacy CJK
    /// codecs overlap far too much to pick between by trial decode, since
    /// Shift-JIS happily accepts GB18030 bytes and returns fluent-looking
    /// nonsense. A file that neither path can read is dropped rather than
    /// shipped as mojibake.
    static func decodeSource(_ data: Data) -> String? {
        if let s = String(data: data, encoding: .utf8) { return s }
        var converted: NSString?
        var lossy = ObjCBool(false)
        let enc = NSString.stringEncoding(for: data, encodingOptions: nil,
                                          convertedString: &converted,
                                          usedLossyConversion: &lossy)
        guard enc != 0, !lossy.boolValue, let s = converted as String?,
              !s.unicodeScalars.contains("\u{FFFD}") else { return nil }
        return s
    }
        let repoDirs = ((try? fm.contentsOfDirectory(at: cacheDir, includingPropertiesForKeys: [.isDirectoryKey])) ?? [])
            .filter { (try? $0.resourceValues(forKeys: [.isDirectoryKey]))?.isDirectory == true }
            .sorted { $0.lastPathComponent < $1.lastPathComponent }
        for repoDir in repoDirs {
            let repo = repoDir.lastPathComponent
            var files: [URL] = []
            if let e = fm.enumerator(at: repoDir, includingPropertiesForKeys: [.isRegularFileKey]) {
                while let url = e.nextObject() as? URL {
                    if (try? url.resourceValues(forKeys: [.isRegularFileKey]))?.isRegularFile == true {
                        files.append(url)
                    }
                }
            }
            for fileURL in files.sorted(by: { $0.path < $1.path }) {
                guard let data = try? Data(contentsOf: fileURL) else { continue }
                let digest = Data(Insecure.SHA1.hash(data: data))
                guard !seen.contains(digest) else { continue }
                seen.insert(digest)
                guard let text = decodeSource(data), let lines = cleanLines(text) else { continue }
                let block = Data((lines.joined(separator: "\n") + "\n").utf8)
                try out.write(contentsOf: block)
                index[repo, default: []].append([offset, block.count])
                offset += block.count
                result.fileCount += 1
            }
        }
        try out.close()
        result.repoCount = index.count
        result.bytes = offset

        guard result.fileCount > 0 else {
            try? fm.removeItem(at: binTmp)
            throw FetchError.emptyCorpus
        }
        try JSONSerialization.data(withJSONObject: index, options: [.sortedKeys]).write(to: idxTmp)
        try CorpusStore.replaceFile(at: corpusDir.appendingPathComponent("corpus.bin"), with: binTmp)
        try CorpusStore.replaceFile(at: corpusDir.appendingPathComponent("corpus-index.json"), with: idxTmp)
        return result
    }
}
