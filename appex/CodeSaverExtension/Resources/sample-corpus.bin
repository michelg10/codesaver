    private var separatorGlyphs: [Character] {
        let n = max(1, tuning.loopGap)
        switch tuning.separator {
        case "∙":
            var g = Array(repeating: Character(" "), count: n)
            g[n / 2] = "∙"
            return g
        case "─":
            if n < 3 { return ["─"] }
            return [" "] + Array(repeating: Character("─"), count: n - 2) + [" "]
        default:
            return Array(repeating: " ", count: n)
        }
    }

    func plan(_ s: String) -> Plan {
        let mt = MarqueeText(s, measure: measure)
        var p = Plan(text: mt, sep: separatorGlyphs)
        guard width > 0, mt.total > width else { return p }
        p.scrolls = true
        // Walk one glyph at a time until the remainder fits the field — a wide
        // glyph is one step like any other, it just frees two cells. With edge
        // marks on, the far end also carries a leading … so the tail gets one
        // cell less.
        let endW = tuning.edgeMarks && tuning.modeValue != .loop ? width - 1 : width
        var over = 0, rest = mt.total
        while over < mt.chars.count, rest > endW { rest -= mt.cells[over]; over += 1 }
        p.over = over
        p.ring = mt.chars.count + p.sep.count
        return p
    }

    /// Length of this text's own cycle; 0 when it does not scroll.
    func ownCycle(_ p: Plan) -> Double {
        guard p.scrolls else { return 0 }
        let step = tuning.stepSeconds
        switch tuning.modeValue {
        case .snap:   return tuning.holdStart + Double(p.over) * step + tuning.holdEnd
        case .bounce: return tuning.holdStart + Double(p.over) * step * 2 + tuning.holdEnd
        case .loop:   return tuning.holdStart + Double(p.ring) * step
        }
    }

    /// Steps walked (for the caption).
    func steps(_ p: Plan) -> Int { tuning.modeValue == .loop ? p.ring : p.over }

    /// The visible text at `t` seconds into a cycle of length `cycle` — the
    /// text's own, or a shared one when title and artist are locked together.
    func window(_ p: Plan, t: Double, cycle: Double) -> String {
        guard p.scrolls else { return String(p.text.chars) }
        let step = tuning.stepSeconds, h0 = tuning.holdStart
        let mt = p.text
        switch tuning.modeValue {
        case .loop:
            // The ring is the text, the gap, then the text again. A shared
            // cycle pads the shorter ring with blanks so both wrap together.
            let ringUse = max(p.ring, Int(((cycle - h0) / step).rounded()))
            var ring = mt.chars + p.sep
            if ringUse > ring.count { ring += Array(repeating: " ", count: ringUse - ring.count) }
            let off = t < h0 ? 0 : min(ring.count - 1, max(0, Int((t - h0) / step)))
            var used = 0, out = ""
            for k in 0..<ring.count {
                let ch = ring[(off + k) % ring.count]
                let n = measure(ch)
                if used + n > width { break }
                used += n; out.append(ch)
            }
            return out
        case .snap, .bounce:
            var off: Int
            let backStart = cycle - Double(p.over) * step
            if tuning.modeValue == .bounce, t >= backStart {
                off = p.over - 1 - Int((t - backStart) / step)
            } else if t < h0 {
                off = 0
            } else {
                off = Int((t - h0) / step)
            }
            let start = min(p.over, max(0, off))
            let edge = tuning.edgeMarks
            let leftMark = edge && start > 0
            var avail = width - (leftMark ? 1 : 0)
            let restCells = mt.cells[start...].reduce(0, +)
            let rightMark = edge && restCells > avail
            if rightMark { avail -= 1 }
            var used = 0, out = ""
            for k in start..<mt.chars.count {
                if used + mt.cells[k] > avail { break }
                used += mt.cells[k]; out.append(mt.chars[k])
            }
            return (leftMark ? "\u{2026}" : "") + out + (rightMark ? "\u{2026}" : "")
        }
    }
}
    private func artRows(cols: Int, rows: Int) -> [NSAttributedString] {
        if let c = artCache, c.cols == cols { return c.rows }
        func hash(_ i: Int, _ j: Int) -> Double {
            let v = sin(Double(i) * 12.9898 + Double(j) * 78.233) * 43758.5453
            return v - floor(v)
        }
        var out: [NSAttributedString] = []
        for j in 0..<rows {
            let line = NSMutableAttributedString()
            for i in 0..<cols {
                let u = (Double(i) + 0.5) / Double(cols), v = (Double(j) + 0.5) / Double(rows)
                let d1 = hypot(u - 0.38, v - 0.42) / 0.5, d2 = hypot(u - 0.72, v - 0.70) / 0.45
                let b = max(0, 1 - d1) * 0.7 + max(0, 1 - d2) * 0.5
                let tone = min(1, 0.10 + 0.6 * b)
                let steps = Double(Self.ramp.count)
                let idx = Int(min(steps - 1, max(0, floor(tone * steps + hash(i, j) - 0.5))))
                let cool: [Double] = [0.44, 0.52, 0.64], warm: [Double] = [0.80, 0.50, 0.38]
                let k = (0.35 + 0.65 * tone) * 0.62
                let c = NSColor(deviceRed: (cool[0] + (warm[0] - cool[0]) * u) * k,
                                green: (cool[1] + (warm[1] - cool[1]) * u) * k,
                                blue: (cool[2] + (warm[2] - cool[2]) * u) * k, alpha: 1)
                line.append(NSAttributedString(string: String(Self.ramp[idx]),
                                               attributes: [.font: font!, .foregroundColor: c]))
            }
            out.append(line)
        }
        artCache = (cols, out)
        return out
    }

    private struct Row { var runs: [(String, [NSAttributedString.Key: Any])] }

    override func draw(_ dirty: NSRect) {
        setupFont()
        NSColor(white: 0.05, alpha: 1).setFill()
        bounds.fill()

        let field = tuning.fieldCells
        let inner = field + 3
        let engine = MarqueeEngine(tuning: tuning, width: field) { [unowned self] in self.glyph($0).cells }
        let pt = engine.plan(title), pa = engine.plan(artist)
        let ct = engine.ownCycle(pt), ca = engine.ownCycle(pa)
        let e = elapsed
        let shared = max(ct, ca)
        func tIn(_ c: Double) -> Double { c > 0 ? e.truncatingRemainder(dividingBy: c) : 0 }
        let titleS: String, artistS: String
        if tuning.sync {
            titleS = engine.window(pt, t: tIn(shared), cycle: shared)
            artistS = engine.window(pa, t: tIn(shared), cycle: shared)
        } else {
            titleS = engine.window(pt, t: tIn(ct), cycle: ct)
            artistS = engine.window(pa, t: tIn(ca), cycle: ca)
        }

        let base = font!
        let railC = NSColor(white: 0.26, alpha: 1)
        let labelC = NSColor(deviceRed: 0.31, green: 0.35, blue: 0.39, alpha: 1)
        let titleC = NSColor(deviceRed: 0.58, green: 0.65, blue: 0.72, alpha: 1)
        let cursorC = NSColor(deviceRed: 0.66, green: 0.90, blue: 1.0, alpha: 1)
        func a(_ c: NSColor) -> [NSAttributedString.Key: Any] { [.font: base, .foregroundColor: c] }
        func rep(_ s: String, _ n: Int) -> String { String(repeating: s, count: max(0, n)) }

        let head = "\u{266A} now playing"
        let topFill = max(0, inner - cells(head) - 4)
        let top = Row(runs: [("\u{256D}\u{2500} ", a(railC)), (head, a(labelC)),
                             (" " + rep("\u{2500}", topFill) + "\u{256E}", a(railC))])
        func padRow(_ text: String, _ c: NSColor) -> Row {
            let fill = max(0, inner - cells(text) - 3)
            return Row(runs: [("\u{2502} ", a(railC)), (text, a(c)),
                              (rep(" ", fill) + " \u{2502}", a(railC))])
        }
        var rows = [top, padRow(titleS, titleC), padRow(artistS, NSColor(white: 0.40, alpha: 1))]

        // The art box: cols = the field, rows from the 1:1 lock; its height is
        // reserved by blank rail rows and the cover drawn over them.
        let artCols = field, artRowsN = max(4, field / 2)
        let stepA = charW * 2
        let artH = stepA * CGFloat(artRowsN) + 4
        let blank = max(1, Int((artH / lineH).rounded(.up)))
        for _ in 0..<blank { rows.append(padRow("", titleC)) }
    private static let presets: [(String, String)] = [
        ("Bohemian Rhapsody (Remastered 2011)", "Queen"),
        ("Everything In Its Right Place - Live at the Roundhouse, London, 2016", "Radiohead"),
        ("SICKO MODE", "Travis Scott feat. Drake, Big Hawk & Swae Lee"),
        ("Symphony No. 9 in D Minor, Op. 125 \"Choral\": IV. Presto - Allegro assai",
         "Berliner Philharmoniker, Herbert von Karajan, Wiener Singverein"),
        ("\u{591C}\u{306B}\u{99C6}\u{3051}\u{308B} (Yoru ni Kakeru) - From THE BOOK", "YOASOBI"),
        ("Kill Bill (feat. Doja Cat) [Remix] \u{1F3B5}", "SZA"),
        ("Short", "Fits the field"),
    ]

    private struct Knob {
        let key: String, label: String, min: Double, max: Double, integer: Bool, fmt: String
    }
    private static let knobs: [Knob] = [
        Knob(key: "stepSeconds", label: "step per glyph", min: 0.05, max: 0.60, integer: false, fmt: "%.2f s"),
        Knob(key: "holdStart", label: "hold at start", min: 0, max: 4, integer: false, fmt: "%.1f s"),
        Knob(key: "holdEnd", label: "hold at end", min: 0, max: 4, integer: false, fmt: "%.1f s"),
        Knob(key: "loopGap", label: "loop gap", min: 1, max: 12, integer: true, fmt: "%.0f cells"),
        Knob(key: "fieldCells", label: "field width", min: 16, max: 60, integer: true, fmt: "%.0f cells"),
        Knob(key: "fontSize", label: "font", min: 11.5, max: 16.5, integer: false, fmt: "%.1f pt"),
    ]

    private static let fileURL: URL = {
        let exe = Bundle.main.executableURL ?? URL(fileURLWithPath: CommandLine.arguments[0])
        return exe.deletingLastPathComponent().appendingPathComponent("marquee-tuning.json")
    }()

    func applicationDidFinishLaunching(_ n: Notification) {
        if let d = try? Data(contentsOf: Self.fileURL),
           let t = try? JSONDecoder().decode(MarqueeTuning.self, from: d) {
            tuning = t
        }
        buildMenu()
        buildWindow()
        let p = Self.presets[0]
        titleField.stringValue = p.0
        artistField.stringValue = p.1
        panel.title = p.0
        panel.artist = p.1
        apply()
        let t = Timer(timeInterval: 1.0 / 30, repeats: true) { [weak self] _ in
            self?.panel.needsDisplay = true
        }
        RunLoop.main.add(t, forMode: .common)
        timer = t
        NSApp.activate(ignoringOtherApps: true)
    }

    func applicationShouldTerminateAfterLastWindowClosed(_ sender: NSApplication) -> Bool { true }

    private func buildMenu() {
        let main = NSMenu()
        let appItem = NSMenuItem()
        main.addItem(appItem)
        let appMenu = NSMenu()
        appMenu.addItem(withTitle: "Quit Marquee Tuner", action: #selector(NSApplication.terminate(_:)), keyEquivalent: "q")
        appItem.submenu = appMenu
        let editItem = NSMenuItem()
        main.addItem(editItem)
        let edit = NSMenu(title: "Edit")
        edit.addItem(withTitle: "Cut", action: #selector(NSText.cut(_:)), keyEquivalent: "x")
        edit.addItem(withTitle: "Copy", action: #selector(NSText.copy(_:)), keyEquivalent: "c")
        edit.addItem(withTitle: "Paste", action: #selector(NSText.paste(_:)), keyEquivalent: "v")
        edit.addItem(withTitle: "Select All", action: #selector(NSText.selectAll(_:)), keyEquivalent: "a")
        editItem.submenu = edit
        NSApp.mainMenu = main
    }

    private func mono(_ s: String, x: CGFloat, y: CGFloat, w: CGFloat, size: CGFloat = 11,
                      bold: Bool = false, in parent: NSView) -> NSTextField {
        let l = NSTextField(labelWithString: s)
        l.font = .monospacedSystemFont(ofSize: size, weight: bold ? .semibold : .regular)
        l.frame = NSRect(x: x, y: y, width: w, height: 18)
        l.textColor = NSColor(white: 0.80, alpha: 1)
        parent.addSubview(l)
        return l
    }

    private func buildWindow() {
        let W: CGFloat = 1100, H: CGFloat = 660
        let w = NSWindow(contentRect: NSRect(x: 0, y: 0, width: W, height: H),
                         styleMask: [.titled, .closable, .miniaturizable],
                         backing: .buffered, defer: false)
        w.title = "CodeSaver \u{2014} title roll"
        w.appearance = NSAppearance(named: .darkAqua)
        w.isReleasedWhenClosed = false
        let content = NSView(frame: NSRect(x: 0, y: 0, width: W, height: H))
        content.wantsLayer = true
        content.layer?.backgroundColor = NSColor(white: 0.13, alpha: 1).cgColor
        w.contentView = content
        // Actions
        let reset = NSButton(title: "reset to saver", target: self, action: #selector(resetTapped(_:)))
        reset.font = .monospacedSystemFont(ofSize: 11, weight: .regular)
        reset.bezelStyle = .rounded
        place(reset, x: x0, w: 130, h: 24)
        let copy = NSButton(title: "copy JSON", target: self, action: #selector(copyTapped(_:)))
        copy.font = .monospacedSystemFont(ofSize: 11, weight: .regular)
        copy.bezelStyle = .rounded
        place(copy, x: x0 + 140, w: 110, h: 24)
        top += 36

        status = NSTextField(wrappingLabelWithString: "")
        status.font = .monospacedSystemFont(ofSize: 10, weight: .regular)
        status.textColor = NSColor(white: 0.55, alpha: 1)
        status.isSelectable = true
        place(status, x: x0, w: cw, h: H - top - 16)

        w.center()
        w.makeKeyAndOrderFront(nil)
        window = w
    }

    // MARK: State → controls, file

    private func value(_ key: String) -> Double {
        switch key {
        case "stepSeconds": return tuning.stepSeconds
        case "holdStart": return tuning.holdStart
        case "holdEnd": return tuning.holdEnd
        case "loopGap": return Double(tuning.loopGap)
        case "fieldCells": return Double(tuning.fieldCells)
        case "fontSize": return tuning.fontSize
        default: return 0
        }
    }
    private func set(_ key: String, _ v: Double) {
        switch key {
        case "stepSeconds": tuning.stepSeconds = (v * 100).rounded() / 100
        case "holdStart": tuning.holdStart = (v * 10).rounded() / 10
        case "holdEnd": tuning.holdEnd = (v * 10).rounded() / 10
        case "loopGap": tuning.loopGap = Int(v.rounded())
        case "fieldCells": tuning.fieldCells = Int(v.rounded())
        case "fontSize": tuning.fontSize = (v * 10).rounded() / 10
        default: break
        }
    }

    private func apply() {
        let mode = tuning.modeValue
        modeCtl.selectedSegment = MarqueeMode.allCases.firstIndex(of: mode) ?? 0
        for k in Self.knobs {
            let v = value(k.key)
            sliders[k.key]?.doubleValue = v
            values[k.key]?.stringValue = String(format: k.fmt, v)
            let on: Bool
            switch k.key {
            case "loopGap": on = mode == .loop
            case "holdEnd": on = mode != .loop
            default: on = true
            }
            sliders[k.key]?.isEnabled = on
            values[k.key]?.textColor = NSColor(white: on ? 0.90 : 0.40, alpha: 1)
            knobLabels[k.key]?.textColor = NSColor(white: on ? 0.80 : 0.40, alpha: 1)
        }
        sepPop.isEnabled = mode == .loop
        sepPop.selectItem(withTitle: tuning.separator)
        if sepPop.indexOfSelectedItem < 0 { sepPop.selectItem(at: 0) }
        edgeBox.state = tuning.edgeMarks ? .on : .off
        edgeBox.isEnabled = mode != .loop
        syncBox.state = tuning.sync ? .on : .off
        panel.tuning = tuning
        panel.needsDisplay = true
        save()
    }

    private func json() -> String {
        let enc = JSONEncoder()
        enc.outputFormatting = [.prettyPrinted, .sortedKeys]
        return (try? enc.encode(tuning)).flatMap { String(data: $0, encoding: .utf8) } ?? "{}"
    }

    private func save() {
        try? json().write(to: Self.fileURL, atomically: true, encoding: .utf8)
        status.stringValue = "saved \u{2192} \(Self.fileURL.path)\n\n" + json()
    }

    // MARK: Actions
    static let perfEnabled = ProcessInfo.processInfo.environment["CODESAVER_PERF"] == "1"

    static var tuner: Tuner?

    /// Scene seed for the snapshot harness: CODESAVER_SEED (decimal or
    /// 0x-hex), else the constant detonate() pins its BoomCore to. A value
    /// that doesn't parse is reported, not silently swapped for the default.
    static var sceneSeed: UInt64 {
        let fallback: UInt64 = 0xC0DE_5AFE
        guard let raw = ProcessInfo.processInfo.environment["CODESAVER_SEED"]?
                .trimmingCharacters(in: .whitespaces), !raw.isEmpty else { return fallback }
        let lower = raw.lowercased()
        let parsed = lower.hasPrefix("0x")
            ? UInt64(lower.dropFirst(2), radix: 16)
            : UInt64(raw)
        guard let v = parsed else {
            FileHandle.standardError.write(
                Data("CODESAVER_SEED=\(raw) is not a UInt64; using default seed\n".utf8))
            return fallback
        }
        return v
    }

    /// The stand-in desktop, decoded once — the backdrop for any display we
    /// couldn't screenshot.
    static let standInImage: CGImage? = {
        guard let path = ProcessInfo.processInfo.environment["CODESAVER_CAPTURE"],
              let img = NSImage(contentsOfFile: path) else { return nil }
        return img.cgImage(forProposedRect: nil, context: nil, hints: nil)
    }()

    static func standIn() -> CGImage? { standInImage }

    static func runWindow() {
        let app = NSApplication.shared
        app.setActivationPolicy(.regular)
        // A menu bar, so ⌘Q always quits (an app without a Quit item has no
        // ⌘Q at all) and ⌘H hides the saver windows.
        tuner = Tuner()
        let menubar = NSMenu()
        let appItem = NSMenuItem(); menubar.addItem(appItem)
        let appMenu = NSMenu()
        let hide = NSMenuItem(title: "Hide saver windows", action: #selector(Tuner.hideScreensMenu(_:)),
                              keyEquivalent: "h")
        hide.target = tuner
        appMenu.addItem(hide)
        appMenu.addItem(withTitle: "Quit preview", action: #selector(NSApplication.terminate(_:)),
                        keyEquivalent: "q")
        appItem.submenu = appMenu
        app.mainMenu = menubar
        tuner?.show()
        app.activate(ignoringOtherApps: true)
        // Activation is cooperative: launched from a parent that isn't
        // frontmost, the first request is often refused and every keystroke
        // (esc included) keeps going to whatever was in front — under a
        // window that covers the screen. Keep asking for a few seconds.
        for delay in [0.3, 0.8, 1.5, 3.0] {
            DispatchQueue.main.asyncAfter(deadline: .now() + delay) {
                app.activate(ignoringOtherApps: true)
                tuner?.focusPanel()
            }
        }
        app.run()
    }
/// The saver, running for real on every attached display, with a floating
/// panel to scrub and tune it.
///
/// Each display gets a borderless screen-saver-level window at that display's
/// exact frame, so the views see true geometry — real point sizes, real cell
/// grids, real per-display cost. All of them share ONE BoomCore built from the
/// displays' CG rects, exactly as a session run does, so the fronts sweep
/// across the whole wall as one event instead of each screen booming alone.
///
/// The clock is the panel's, not the saver's (`externallyDriven`), and the
/// timeline is measured in whole 1/30 s frames — the beat the shipping saver
/// ticks on. A position on the slider is exactly N calls to advance() on every
/// view, so:
///
///   • scrubbing forward is stepping (what playback does),
///   • scrubbing back, or moving a `.sim` knob, replays from frame 0 against
///     the same seeds, so only the knob you moved differs,
///   • a `.paint` knob is a bare repaint at the current frame, which is what
///     makes those sliders feel attached to the picture.
final class Tuner: NSObject {
    private static let fps = 30.0

    /// One attached display: its CG rect (the space BoomCore works in) and
    /// the screenshot standing in for its desktop.
    private struct Display {
        let screen: NSScreen
        let cg: CGRect
        var capture: CGImage?

        var id: CGDirectDisplayID {
            (screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")]
                as? CGDirectDisplayID) ?? CGMainDisplayID()
        }
    }

    private var displays: [Display] = []
    private var views: [CodeSaverView] = []
    private var screenWindows: [NSWindow] = []
    private var hosts: [ScreenHost] = []
    private var panel: NSPanel!
    private var core: BoomCore?
    private var screensVisible = true

    // Timeline
    private var frame = 0                 // whole 1/30 s steps since arm start
    private var frameCount = 1
    private var seed: UInt64 = 0xC0DE_5AFE
    /// Detonation point in global CG coordinates — the space the displays are
    /// laid out in, so it can sit on any screen (or in a gap between them).
    private var origin = CGPoint.zero
    private var arm = 1.2
    private var playing = false
    private var playTimer: Timer?
    /// Coalesces a burst of slider events into one replay per runloop pass.
    private var pendingSeek: Int?
    private var pendingRebuild = false
    /// Leftover scroll distance below one frame's worth.
    private var scrollAccum: CGFloat = 0

    // Controls
    private var scrub: NSSlider!
    private var frameField: NSTextField!
    private var frameStepper: NSStepper!
    private var playButton: NSButton!
    private var screensButton: NSButton!
    private var readout: NSTextField!
    private var beatLabel: NSTextField!
    private var geometryLabel: NSTextField!
    private var armField: NSSlider!
    private var armLabel: NSTextField!
    private var sliders: [String: NSSlider] = [:]
    private var values: [String: NSTextField] = [:]
    private var defaults: [String: Double] = [:]

    private var lead: CodeSaverView? { views.first }

    // MARK: Bring-up

    func show() {
        displays = Self.attachedDisplays()
        // Centre of the main display, until you click somewhere.
        origin = CGPoint(x: displays[0].cg.midX, y: displays[0].cg.midY)
        buildScreenWindows()
        buildPanel()
        for k in Knobs.all { defaults[k.key] = lead.map(k.get) ?? 0 }
        rebuild()
        installKeyMonitor()
        // Real screenshots land a beat later; the stand-in covers until then.
        captureDisplays { [weak self] shots in
            guard let self else { return }
            var got = 0
            for i in self.displays.indices {
                if let img = shots[self.displays[i].id] { self.displays[i].capture = img; got += 1 }
            }
            print(got > 0 ? "captured \(got)/\(self.displays.count) displays"
                          : "no screen capture (grant Screen Recording, or drop build/stand-in-capture.png) — using the stand-in")
            fflush(stdout)
            self.rebuild()
        }
    }
    // MARK: Timeline

    private enum Beat { case arm, detonation, halfWave1, wave2, settle, end }

    private var armFrames: Int { Int((arm * Self.fps).rounded()) }

    /// The whole show, plus a few seconds of steady state to scrub into.
    private func recomputeLength() {
        guard let lead else { return }
        let tail = lead.boomGap + lead.boomWave2 + 4.5
        frameCount = max(2, armFrames + Int((tail * Self.fps).rounded()))
        scrub.minValue = 0
        scrub.maxValue = Double(frameCount)
        // One tick per frame, values-only: dragging lands on whole frames
        // instead of a float we'd have to round behind your back.
        scrub.numberOfTickMarks = frameCount + 1
        scrub.allowsTickMarkValuesOnly = true
        scrub.tickMarkPosition = .below
        frameStepper.maxValue = Double(frameCount)
    }

    private func jump(to beat: Beat) {
        guard let lead else { return }
        pause()
        let f: Int
        switch beat {
        case .arm:        f = 0
        case .detonation: f = armFrames
        case .halfWave1:  f = armFrames + Int(lead.boomWave1 * 0.5 * Self.fps)
        case .wave2:      f = armFrames + Int(lead.boomGap * Self.fps)
        case .settle:     f = armFrames + Int((lead.boomGap + lead.boomWave2) * Self.fps)
        case .end:        f = frameCount
        }
        seek(to: f)
    }

    private func nudge(_ delta: Int) {
        pause()
        seek(to: frame + delta)
    }

    @objc private func scrubbed(_ s: NSSlider) {
        pause()
        seek(to: Int(s.doubleValue.rounded()))
    }

    @objc private func stepped(_ s: NSStepper) {
        nudge(Int(s.doubleValue.rounded()) - frame)
    }

    @objc private func frameTyped(_ f: NSTextField) {
        pause()
        seek(to: Int(f.doubleValue.rounded()))
    }

    /// Scroll over any preview screen to walk the timeline — a trackpad flick
    /// is the closest thing to shuttling frame by frame. One frame per ~8
    /// points of scroll, whichever axis you push.
    private func shuttle(by points: CGFloat) {
        scrollAccum += points
        let steps = Int(scrollAccum / 8)
        guard steps != 0 else { return }
        scrollAccum -= CGFloat(steps) * 8
        nudge(steps)
    }

    /// Requests a timeline position. The work is deferred one runloop hop so a
    /// drag that fires twenty events replays once, not twenty times.
    private func seek(to f: Int) {
        let clamped = max(0, min(frameCount, f))
        let had = pendingSeek != nil || pendingRebuild
        pendingSeek = clamped
        if !had { DispatchQueue.main.async { [weak self] in self?.flush() } }
    }

    /// Replays from frame 0 at the current knob values — what a `.sim` knob, a
    /// new origin/arm, or a fresh screenshot needs.
    private func rebuild() {
        recomputeLength()
        let had = pendingSeek != nil || pendingRebuild
        pendingRebuild = true
        if pendingSeek == nil { pendingSeek = min(frame, frameCount) }
        if !had { DispatchQueue.main.async { [weak self] in self?.flush() } }
    }
    // MARK: Keyboard
    //
    // A local monitor rather than keyDown on a view: the preview windows never
    // take key (the panel keeps it), and the moment you touch a slider the
    // focus is gone — "arrows step frames" has to keep working wherever the
    // focus ended up. Only text editing wins over it.

    private func installKeyMonitor() {
        NSEvent.addLocalMonitorForEvents(matching: .keyDown) { [weak self] event in
            guard let self, !(self.panel.firstResponder is NSTextView) else { return event }
            return self.handleKey(event) ? nil : event
        }
    }

    private func handleKey(_ event: NSEvent) -> Bool {
        let step = event.modifierFlags.contains(.shift) ? 10 : 1
        switch event.charactersIgnoringModifiers {
        case " ": togglePlay(); return true
        case String(UnicodeScalar(NSLeftArrowFunctionKey)!), ",":  nudge(-step); return true
        case String(UnicodeScalar(NSRightArrowFunctionKey)!), ".": nudge(step); return true
        case String(UnicodeScalar(NSHomeFunctionKey)!): nudge(-1 << 20); return true
        case String(UnicodeScalar(NSEndFunctionKey)!):  nudge(1 << 20); return true
        case "\u{1B}": NSApp.terminate(nil); return true       // esc — the way out
        case "h": toggleScreens(); return true
        case "r": reroll(); return true
        default: return false
        }
    }

    // MARK: Small builders

    private func fmt(_ knob: Knob, _ v: Double) -> String {
        knob.integer ? String(Int(v.rounded())) : String(format: "%.2f", v)
    }

    private func mono(_ text: String, x: CGFloat, y: CGFloat, w: CGFloat,
                      size: CGFloat, bold: Bool = false) -> NSTextField {
        let f = NSTextField(labelWithString: text)
        f.frame = NSRect(x: x, y: y, width: w, height: 18)
        f.font = .monospacedSystemFont(ofSize: size, weight: bold ? .semibold : .regular)
        f.textColor = NSColor(calibratedWhite: 0.86, alpha: 1)
        return f
    }

    private func button(_ title: String, x: CGFloat, y: CGFloat, w: CGFloat,
                        action: @escaping () -> Void) -> NSButton {
        let b = ActionButton(title: title, target: nil, action: nil)
        b.run = action
        b.target = b
        b.action = #selector(ActionButton.fire)
        b.bezelStyle = .rounded
        b.frame = NSRect(x: x, y: y, width: w, height: 26)
        return b
    }
}

// MARK: - Screen capture

/// One-shot screenshots of every display at NATIVE pixel resolution — the
/// igniter's capture, verbatim (including the rect form that keeps window
/// shadows; see captureDisplays in helper/Igniter.swift), so the preview's
/// backdrops are the same pixels production would have handed the saver.
/// Needs Screen Recording; without it the caller falls back to the stand-in
/// desktop.
private func captureDisplays(_ completion: @escaping ([CGDirectDisplayID: CGImage]) -> Void) {
    guard #available(macOS 14.0, *) else { completion([:]); return }
    SCShareableContent.getExcludingDesktopWindows(false, onScreenWindowsOnly: true) { content, err in
        guard let content else {
            if let err { print("screen capture unavailable: \(err.localizedDescription)") }
            DispatchQueue.main.async { completion([:]) }
            return
        }
        var result: [CGDirectDisplayID: CGImage] = [:]
        let lock = NSLock()
        let group = DispatchGroup()
        for display in content.displays {
            group.enter()
            let store: (CGImage?) -> Void = { image in
                if let image {
                    lock.lock(); result[display.displayID] = image; lock.unlock()
                }
                group.leave()
            }
            if #available(macOS 15.2, *) {
                SCScreenshotManager.captureImage(in: CGDisplayBounds(display.displayID)) {
                    image, _ in store(image)
                }
            } else {
                let config = SCStreamConfiguration()
                let mode = CGDisplayCopyDisplayMode(display.displayID)
                config.width = mode.map(\.pixelWidth) ?? display.width
                config.height = mode.map(\.pixelHeight) ?? display.height
                config.showsCursor = false
                SCScreenshotManager.captureImage(
                    contentFilter: SCContentFilter(display: display, excludingWindows: []),
                    configuration: config
                ) { image, _ in store(image) }
            }
        }
        group.notify(queue: .main) { completion(result) }
    }
}
        /// Keyed access by the same names the JSON uses.  An unknown key reads 0 and
        /// swallows writes, so a stale tuning file can never trap the renderer.
        subscript(key: String) -> Double {
            get {
                switch key {
                case "cols":  return cols
                case "rows":  return rows
                case "gamma": return gamma
                case "loPct": return loPct
                case "hiPct": return hiPct
                case "sharp": return sharp
                case "peak":  return peak
                case "aExp":  return aExp
                case "inkK":  return inkK
                case "sat":   return sat
                default:      return 0
                }
            }
            set {
                switch key {
                case "cols":  cols  = newValue
                case "rows":  rows  = newValue
                case "gamma": gamma = newValue
                case "loPct": loPct = newValue
                case "hiPct": hiPct = newValue
                case "sharp": sharp = newValue
                case "peak":  peak  = newValue
                case "aExp":  aExp  = newValue
                case "inkK":  inkK  = newValue
                case "sat":   sat   = newValue
                default:      break
                }
            }
        }

        /// Slider descriptors for the tuning window — the renderer is the single source
        /// of truth for what exists, what it is called, and how far it may travel.
        static let tunables: [AlbumArtTunable] = [
            AlbumArtTunable("cols",  "columns",       8,  120, group: "Size"),
            AlbumArtTunable("rows",  "rows",          8,   80, group: "Size"),

            AlbumArtTunable("gamma", "gamma",       0.3,  3.0, group: "Tone"),
            AlbumArtTunable("loPct", "black point", 0.0, 20.0, group: "Tone"),
            AlbumArtTunable("hiPct", "white point", 80.0, 100.0, group: "Tone"),
            AlbumArtTunable("sharp", "unsharp",     0.0,  3.0, group: "Tone"),

            AlbumArtTunable("peak",  "peak luma",  60.0, 255.0, group: "Colour"),
            AlbumArtTunable("aExp",  "tone exponent", 0.3, 3.0, group: "Colour"),
            AlbumArtTunable("inkK",  "ink comp",    0.0,  1.5, group: "Colour"),
            AlbumArtTunable("sat",   "saturation",  0.0,  3.0, group: "Colour"),
        ]

        /// The grid, as the sampler needs it: whole cells, never small enough to make
        /// the percentile/unsharp stages degenerate.
        var colCount: Int { Self.gridCount(cols) }
        var rowCount: Int { Self.gridCount(rows) }

        private static func gridCount(_ v: Double) -> Int {
            guard v.isFinite else { return minGrid }
            let r = v.rounded()
            if r <= Double(minGrid) { return minGrid }
            if r >= Double(maxGrid) { return maxGrid }
            return Int(r)
        }

        private static let minGrid = 8
        private static let maxGrid = 4096
    }

    // MARK: - Fixed constants (measured, not tuned)

    /// (glyph, measured SF Mono ink coverage %) — strictly increasing.
    /// Regenerate with `ramp.py --measure`.
    static let ramp: [(glyph: Character, ink: Double)] = [
        (" ",  0.00), ("·",  2.30), ("-",  5.53), (":",  6.90), ("!",  8.02),
        ("/",  9.48), ("+", 10.25), ("=", 11.56), ("x", 12.73), ("*", 13.89),
        ("o", 15.36), ("X", 17.36), ("C", 18.21), ("%", 19.99), ("#", 20.52),
        ("D", 21.93), ("W", 22.42), ("0", 23.33), ("Q", 24.05),
    ]

    static let aRef = 24.05     // pivot: the densest plain glyph.  comp == 1 there.

    /// Rec.709 luma weights.
    static let wR = 0.2126
    static let wG = 0.7152
    static let wB = 0.0722

    // MARK: - Public API
        var out = [Double](repeating: 0, count: rows * cols * 3)
        px.withUnsafeBufferPointer { p in
            for j in 0..<rows {
                // Degenerate bands appear only when the source is shorter/narrower than the
                // grid; widen to one pixel rather than average an empty slice (numpy: NaN).
                var y0 = ys[j], y1 = ys[j + 1]
                if y1 <= y0 { y0 = min(y0, h - 1); y1 = y0 + 1 }
                for i in 0..<cols {
                    var x0 = xs[i], x1 = xs[i + 1]
                    if x1 <= x0 { x0 = min(x0, w - 1); x1 = x0 + 1 }
                    var sr = 0.0, sg = 0.0, sb = 0.0
                    for y in y0..<y1 {
                        let row = y * w * 4
                        for x in x0..<x1 {
                            let o = row + x * 4
                            sr += linearLUT[Int(p[o])]
                            sg += linearLUT[Int(p[o + 1])]
                            sb += linearLUT[Int(p[o + 2])]
                        }
                    }
                    let n = Double((y1 - y0) * (x1 - x0))
                    let d = (j * cols + i) * 3
                    out[d]     = sr / n
                    out[d + 1] = sg / n
                    out[d + 2] = sb / n
                }
            }
        }
        return out
    }

    // MARK: - Tone

    /// Linear cell RGB -> t in 0..1, the tone every later decision is taken from.
    private static func tone(_ cells: [Double], _ params: Params) -> [Double] {
        let cols = params.colCount, rows = params.rowCount
        var v = [Double](repeating: 0, count: rows * cols)
        for i in 0..<v.count {
            let o = i * 3
            v[i] = toSRGB(cells[o] * wR + cells[o + 1] * wG + cells[o + 2] * wB)
        }
        v = unsharp(v, amount: params.sharp, cols: cols, rows: rows)

        let lo = percentile(v, params.loPct)
        let hi = percentile(v, params.hiPct)
        let span = Swift.max(hi - lo, 1e-6)

        var t = [Double](repeating: 0, count: v.count)
        for i in 0..<v.count {
            var x = (v[i] - lo) / span
            if x < 0 { x = 0 } else if x > 1 { x = 1 }
            t[i] = pow(x, params.gamma)
        }
        return t
    }

    /// Local-contrast boost on the CELL grid — recovers edges the downsample softened.
    /// Edge-replicating 3x3 box blur, summed in the same order numpy's `sum(...)` uses.
    private static func unsharp(_ cells: [Double], amount: Double,
                                cols: Int, rows: Int) -> [Double] {
        guard amount > 0 else { return cells }
        let pw = cols + 2, ph = rows + 2
        var p = [Double](repeating: 0, count: pw * ph)
        for j in 0..<ph {
            let sj = Swift.min(Swift.max(j - 1, 0), rows - 1)
            for i in 0..<pw {
                let si = Swift.min(Swift.max(i - 1, 0), cols - 1)
                p[j * pw + i] = cells[sj * cols + si]
            }
        }
        var out = [Double](repeating: 0, count: cells.count)
        for j in 0..<rows {
            for i in 0..<cols {
                var s = 0.0
                for dj in 0..<3 {
                    let base = (j + dj) * pw + i
                    for di in 0..<3 { s += p[base + di] }
                }
                let c = cells[j * cols + i]
                out[j * cols + i] = c + amount * (c - s / 9.0)
            }
        }
        return out
    }
                let r = Int((toSRGB(fit.0 * Y) * 255.0).rounded(.toNearestOrEven))
                let g = Int((toSRGB(fit.1 * Y) * 255.0).rounded(.toNearestOrEven))
                let b = Int((toSRGB(fit.2 * Y) * 255.0).rounded(.toNearestOrEven))

                line.append(entry.glyph)
                crow.append(hex(r, g, b))
            }
            chars.append(line)
            colors.append(crow)
        }
        return (chars, colors)
    }
}
//
//  AlbumArtShared.swift
//  CodeSaver — compiled into BOTH the host app and the saver extension.
//
//  Three things the app's tuning window and the saver must agree on:
//
//    1. AlbumArtTunable — a renderer parameter's UI descriptor, so the
//       tuning window builds its sliders from the renderers themselves
//       rather than a hand-kept list that silently rots.
//    2. AlbumArtGrid — a rendered art grid plus the ONE drawing routine
//       both sides use. The preview is only worth having if it is
//       pixel-identical to the saver, which means exactly one
//       implementation of "draw this grid".
//    3. AlbumArtTuning — where tuned values live (the app-group
//       container) so the daemon renders with them and the saver shows
//       the result without a rebuild.
//

import AppKit
import Foundation

// MARK: - Parameter descriptor

/// One tunable knob on a renderer: how to reach it (`key`, matching the
/// Params JSON and subscript), what to call it, and a sane slider range.
struct AlbumArtTunable {
    let key: String
    let label: String
    let min: Double
    let max: Double
    /// Coarse grouping for the tuning window's section headers.
    let group: String

    init(_ key: String, _ label: String, _ min: Double, _ max: Double,
         group: String = "") {
        self.key = key
        self.label = label
        self.min = min
        self.max = max
        self.group = group
    }
}

// MARK: - A rendered grid

/// The renderer's JSON output, parsed. Cells are the panel's own monospace
/// glyphs at a 2:1 aspect — the aspect the ramp's sampling assumed — so the
/// grid carries no font metrics of its own and lands on the chrome's
/// character grid wherever it is drawn.
struct AlbumArtGrid {
    var cols = 0
    var rows = 0
    var chars: [String] = []
    var colors: [[String]] = []
    /// The parameters this grid was rendered with, in `AlbumArtTuning.load()`
    /// shape, and the image it was rendered from — both optional. The tuning
    /// window stamps them so a consumer that has to RE-RENDER at a smaller
    /// grid (the saver fitting art to its panel) reproduces the knobs as they
    /// are right now, not as they were last saved, from the image actually
    /// on screen rather than always the current track's.
    var tuning: [String: [String: Double]]?
    var sourcePath: String?

    /// JSON keys for the two optional stamps above — one definition, used by
    /// the publisher and the parser.
    static let tuningKey = "tuning"
    static let sourceKey = "source"

    init?(json o: [String: Any]) {
        guard let cols = o["cols"] as? Int, let rows = o["rows"] as? Int,
              let chars = o["chars"] as? [String],
              let colors = o["colors"] as? [[String]],
              chars.count == rows, colors.count == rows else { return nil }
        self.cols = cols
        self.rows = rows
        self.chars = chars
        self.colors = colors
        tuning = o[Self.tuningKey] as? [String: [String: Double]]
        sourcePath = o[Self.sourceKey] as? String
    }

    /// Row pitch in points: a 2:1 cell, the aspect the ramp's sampling assumed.
    static func rowStep(charW: CGFloat) -> CGFloat { charW * 2 }

    /// Exactly cols × rows cells — no padding fudge. The art is positioned on
    /// the panel's character grid, so any stray point here would offset every
    /// glyph against the chrome around it.
    func size(charW: CGFloat) -> NSSize {
        NSSize(width: charW * CGFloat(cols),
               height: Self.rowStep(charW: charW) * CGFloat(rows))
    }
    static func color(_ hex: String) -> NSColor? {
        var h = hex
        if h.hasPrefix("#") { h.removeFirst() }
        guard h.count == 6, let v = UInt32(h, radix: 16) else { return nil }
        return NSColor(deviceRed: CGFloat((v >> 16) & 0xFF) / 255,
                       green: CGFloat((v >> 8) & 0xFF) / 255,
                       blue: CGFloat(v & 0xFF) / 255, alpha: 1)
    }

    /// Lay the grid out once. Callers that redraw every frame (the saver's
    /// panel) cache these and only pay the draw; the layout is identical
    /// either way, so the art lands on the same grid in both.
    func attributedRows(baseFont: NSFont) -> [NSAttributedString] {
        var out: [NSAttributedString] = []
        for (r, line) in chars.enumerated() {
            guard r < colors.count else { break }
            let row = NSMutableAttributedString()
            for (c, ch) in line.enumerated() {
                guard c < colors[r].count else { break }
                row.append(NSAttributedString(string: String(ch), attributes: [
                    .font: baseFont,
                    .foregroundColor: Self.color(colors[r][c]) ?? NSColor.clear,
                ]))
            }
            out.append(row)
        }
        return out
    }

    static func draw(rows: [NSAttributedString], at origin: NSPoint, step: CGFloat) {
        for (r, row) in rows.enumerated() {
            row.draw(at: NSPoint(x: origin.x, y: origin.y + CGFloat(r) * step))
        }
    }

    func draw(baseFont: NSFont, charW: CGFloat, at origin: NSPoint) {
        Self.draw(rows: attributedRows(baseFont: baseFont), at: origin,
                  step: Self.rowStep(charW: charW))
    }
}

// MARK: - Tuned values on disk

/// Tuned parameters live in the app-group container next to the feed, so a
/// slider drag reaches the daemon (which re-renders the current track) and
/// the saver shows it — no rebuild. Absent file = every renderer default.
enum AlbumArtTuning {
    static var url: URL? {
        CorpusStore.widgetsDirectory?.appendingPathComponent("albumart-tuning.json")
    }

    /// `["ramp": [key: value]]`
    static func load() -> [String: [String: Double]] {
        guard let u = url, let d = try? Data(contentsOf: u),
              let o = (try? JSONSerialization.jsonObject(with: d))
                  as? [String: [String: Double]] else { return [:] }
        return o
    }

    static func save(_ v: [String: [String: Double]]) {
        guard let u = url else { return }
        try? FileManager.default.createDirectory(
            at: u.deletingLastPathComponent(), withIntermediateDirectories: true)
        guard let d = try? JSONSerialization.data(withJSONObject: v,
                                                  options: [.sortedKeys]) else { return }
        let tmp = u.deletingLastPathComponent()
            .appendingPathComponent(".albumart-tuning.json.tmp")
        guard (try? d.write(to: tmp)) != nil else { return }
        // rename(2), not remove+move: the saver keys its re-render cache on
        // this file's mtime and must never catch it absent.
        try? CorpusStore.replaceFile(at: u, with: tmp)
    }
}
//
//  AlbumArtTuner.swift
//  CodeSaver — the album-art tuning window (host app only).
//
//  The window IS the saver: a full-scale CodeSaverView, code rain, clock,
//  session panels and all. Art is never looked at in isolation on the glass,
//  so it isn't tuned in isolation either. The knobs live in a floating HUD
//  panel you can drag anywhere (or off the saver entirely).
//
//  Turning a knob re-renders with the SAME native renderer the daemon uses
//  and publishes the result straight into the app-group container, so the
//  saver view — and the real screensaver, if it's up — repaints within a
//  fraction of a second. `Save` then persists the values so the daemon keeps
//  using them for every future track.
//

import AppKit
import ImageIO
import SwiftUI

extension Notification.Name {
    /// Posted in-process whenever widgets/settings.json's `albumArtStyle` is
    /// rewritten — by the main window's picker or by this tuner — so every
    /// view showing the value re-reads it instead of trusting a seed taken
    /// at init. The saver polls the file; the app's own views need a nudge.
    static let albumArtStyleDidChange =
}

// MARK: - Model

@MainActor
final class AlbumArtTunerModel: ObservableObject {
    @Published var ramp = AlbumArtRamp.Params()
    @Published var sourceLabel = "—"
    @Published var hint = ""
    @Published var renderMS = 0.0
    @Published var saved = false
    /// Album art is square; a text grid is not. Locked (the default), moving
    /// either size slider derives the other from the cell aspect so the
    /// rendered block stays 1:1 on screen.
    @Published var lockSquare = true
    /// The app has album art switched off. The tuner still renders and
    /// publishes, but the saver draws nothing until art is turned on — say
    /// so, rather than silently switching it on for the user.
    @Published var artOff = false

    private var image: CGImage?
    /// The file `image` was decoded from — stamped into the published grid
    /// so a consumer re-rendering at another size uses the same pixels.
    private var imageURL: URL?
    /// Only an explicit "turn on" in this window may write the style back to
    /// settings.json. Loading, knob turns and the initial render must not:
    /// with art switched off in the app, it would otherwise be switched on
    /// as a side effect of merely opening the window.
    private var styleChosen = false
    /// What the preview is showing. In `.currentTrack` the artwork must be
    /// re-read when the daemon fetches a new one: publishing under the LIVE
    /// track's key while holding a stale image is how the panel ends up
    /// showing the previous track's cover.
    private enum Source { case currentTrack, file }
    private var source: Source = .currentTrack
    private var srcMTime: Date?
    private var follow: Timer?

    private var srcURL: URL? { widgets?.appendingPathComponent("albumart-src.img") }

    private func mtime(_ u: URL) -> Date? {
        (try? FileManager.default.attributesOfItem(atPath: u.path))?[
            .modificationDate] as? Date
    }

    /// Cell height ÷ cell width, in the same units AlbumArtGrid draws with:
    /// ramp cells are exactly 2:1 (rowStep = charW * 2).
    private let cellAspect = 2.0

    private func clamp(_ key: String, _ v: Double) -> Double {
        guard let t = tunables.first(where: { $0.key == key }) else { return v }
        return Swift.min(Swift.max(v, t.min), t.max)
    }

    private func write(_ key: String, _ v: Double) { ramp[key] = v }

    var tunables: [AlbumArtTunable] { AlbumArtRamp.Params.tunables }

    // MARK: Lifecycle
    /// Snap the current grid to 1:1 (used when the lock is switched on).
    func squareUp() {
        let cols = value("cols")
        write("rows", clamp("rows", (cols / cellAspect).rounded()))
        saved = false
        apply()
    }

    func reset() {
        ramp = AlbumArtRamp.Params()
        saved = false
        apply()
    }

    func save() {
        AlbumArtTuning.save(["ramp": ramp.json])
        saved = true
    }

    // MARK: Publish

    /// Render at the current settings and drop the result where the saver
    /// looks. The art is filed under the PLAYING track's key because that is
    /// what the panel matches on — tuning against an opened image still
    /// previews in place, it just borrows the current track's identity.
    func apply() {
        // Re-read before publishing: the key we stamp must describe the
        // pixels we render, not whatever was loaded when the window opened.
        if case .currentTrack = source, let u = srcURL, mtime(u) != srcMTime,
           let cs = CGImageSourceCreateWithURL(u as CFURL, nil),
           let img = CGImageSourceCreateImageAtIndex(cs, 0, nil) {
            image = img
            srcMTime = mtime(u)
        }
        guard let image, let wdir = widgets else { return }
        let t0 = CFAbsoluteTimeGetCurrent()
        var payload: [String: Any] = ["key": currentTrackKey(),
                                      "ts": Date().timeIntervalSince1970]
        // Stamp the grid with the knobs as they are NOW and the image it came
        // from (AlbumArtGrid reads both back). The saver re-renders at a
        // smaller grid when the panel is short; without these it would use
        // the last SAVED values and the current track's artwork — so the
        // knobs would not respond until Save, and an opened image would not
        // survive the fit.
        let stamp: [String: Any] = [
            AlbumArtGrid.tuningKey: ["ramp": ramp.json],
            AlbumArtGrid.sourceKey: imageURL?.path ?? srcURL?.path ?? "",
        ]
        if let g = AlbumArtRamp.render(image, params: ramp) {
            payload["ramp"] = g.merging(stamp) { _, new in new }
        }
        renderMS = (CFAbsoluteTimeGetCurrent() - t0) * 1000

        let dst = wdir.appendingPathComponent("albumart.json")
        let tmp = wdir.appendingPathComponent(".albumart.json.tuner")
        if let d = try? JSONSerialization.data(withJSONObject: payload),
           (try? d.write(to: tmp)) != nil {
            // rename(2) over the old file: the saver polls this at 4 Hz and
            // clears its grids the instant the file is missing.
            try? CorpusStore.replaceFile(at: dst, with: tmp)
        }
        if styleChosen { writeStyle() }
    }

    /// Switch art on in the app's settings (the saver draws nothing while
    /// it reads "none"). Only on an explicit "turn on": `apply` gates this on
    /// `styleChosen`, so opening the window with art switched off in the app
    /// leaves it off.
    private func writeStyle() {
        guard let u = settingsURL else { return }
        var o: [String: Any] = [:]
        if let d = try? Data(contentsOf: u),
           let e = (try? JSONSerialization.jsonObject(with: d)) as? [String: Any] { o = e }
        guard (o["albumArtStyle"] as? String) != "ramp" else { return }
        o["albumArtStyle"] = "ramp"
        guard let d = try? JSONSerialization.data(withJSONObject: o),
              (try? d.write(to: u, options: .atomic)) != nil else { return }
        NotificationCenter.default.post(name: .albumArtStyleDidChange, object: nil)
    }

    private func currentTrackKey() -> String {
        guard let u = widgets?.appendingPathComponent("feed.json"),
              let d = try? Data(contentsOf: u),
              let o = (try? JSONSerialization.jsonObject(with: d)) as? [String: Any],
              let np = o["nowplaying"] as? [String: Any],
              let app = np["app"] as? String, let title = np["title"] as? String else {
            hint = "nothing playing — the panel only appears with music"
            return "tuner"
        }
        hint = ""
        return "\(app)|\(title)|\(np["artist"] as? String ?? "")"
    }
            Divider()

            ScrollView {
                VStack(alignment: .leading, spacing: 14) {
                    ForEach(groups, id: \.self) { g in
                        VStack(alignment: .leading, spacing: 5) {
                            HStack(spacing: 6) {
                                Text(g.uppercased())
                                    .font(.system(size: 9, weight: .semibold,
                                                  design: .monospaced))
                                    .tracking(1.5)
                                    .foregroundStyle(.tertiary)
                                if g.lowercased() == "size" {
                                    Spacer()
                                    Toggle("1:1", isOn: Binding(
                                        get: { model.lockSquare },
                                        set: { model.lockSquare = $0
                                               if $0 { model.squareUp() } }))
                                        .toggleStyle(.checkbox)
                                        .font(.system(size: 9, design: .monospaced))
                                }
                            }
                            ForEach(model.tunables.filter { $0.group == g }, id: \.key) {
                                knob($0)
                            }
                        }
                    }
                }
                .padding(12)
            }

            Divider()

            HStack(spacing: 8) {
                Button("Save") { model.save() }
                    .buttonStyle(.borderedProminent)
                Button("Defaults") { model.reset() }
                Spacer()
                Text(model.saved ? "saved" : String(format: "%.0f ms", model.renderMS))
                    .font(.system(size: 9, design: .monospaced))
                    .foregroundStyle(.secondary)
            }
            .controlSize(.small)
            .padding(12)
        }
    }

    private var groups: [String] {
        var seen: [String] = []
        for t in model.tunables where !seen.contains(t.group) { seen.append(t.group) }
        return seen
    }

    private func knob(_ t: AlbumArtTunable) -> some View {
        HStack(spacing: 6) {
            Text(t.label)
                .font(.system(size: 10, design: .monospaced))
                .frame(width: 86, alignment: .leading)
            Slider(value: Binding(get: { model.value(t.key) },
                                  set: { model.set(t.key, $0) }),
                   in: t.min...t.max)
            Text(fmt(model.value(t.key)))
                .font(.system(size: 10, design: .monospaced))
                .foregroundStyle(.secondary)
                .frame(width: 44, alignment: .trailing)
        }
    }

    private func fmt(_ v: Double) -> String {
        v == v.rounded() && abs(v) < 10000 ? String(format: "%.0f", v)
                                           : String(format: "%.3g", v)
    }
}
//
//  CodeSaverApp.swift
//  CodeSaver
