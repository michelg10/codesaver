//
//  Principal class for the screensaver extension. Specified as
//  NSExtensionPrincipalClass in Info.plist as
//  `$(PRODUCT_MODULE_NAME).CodeSaverExtension`.
//
//  Following Apple's own screensavers (e.g. Arabesque.appex) we keep this
//  minimal — only implement init() and let the framework drive lifecycle.
//

import Foundation
import ScreenSaver

private let logger = AppexLog.logger("Extension")

@objc(CodeSaverExtension)
class CodeSaverExtension: ScreenSaverExtension {

    @objc override init() {
        logger.info("CodeSaverExtension.init() PID=\(ProcessInfo.processInfo.processIdentifier, privacy: .public)")
        super.init()
    }

    deinit {
        logger.info("CodeSaverExtension.deinit")
    }
}
        let origin = CGPoint(x: mouseX, y: mouseY)
        struct Disp { let x, y, w, h: Double; let image: String? }
        let disps: [Disp] = displayList.compactMap { d in
            guard let x = d["x"] as? Double, let y = d["y"] as? Double,
                  let w = d["w"] as? Double, let h = d["h"] as? Double,
                  w > 8, h > 8 else { return nil }
            return Disp(x: x, y: y, w: w, h: h, image: d["image"] as? String)
        }
        // Grids on the main thread (font metrics); the per-display work fans
        // out across cores. Raw captures ("CSRW", written by the igniter) are
        // mmap'd — no decode at all, the pixels are the helper's own decoded
        // buffer still sitting in the page cache; legacy/stand-in images
        // fall back to an actual decode. Colorize is the only real work left.
        let grids = disps.map { BoomGrid(size: CGSize(width: $0.w, height: $0.h)) }
        var decoded = [(color: [UInt32], image: CGImage, buffer: BoomCaptureBuffer?)?](
            repeating: nil, count: disps.count)
        decoded.withUnsafeMutableBufferPointer { buf in
            DispatchQueue.concurrentPerform(iterations: disps.count) { i in
                guard let name = disps[i].image else { return }
                let url = dir.appendingPathComponent(name)
                if name.hasSuffix(".raw"), let mapped = BoomCaptureBuffer.map(url),
                   let cg = mapped.makeImage() {
                    buf[i] = (BoomCore.colorize(cg, grid: grids[i]), cg, mapped)
                    return
                }
                guard let img = NSImage(contentsOf: url),
                      let cg = img.cgImage(forProposedRect: nil, context: nil, hints: nil)
                else { return }
                buf[i] = (BoomCore.colorize(cg, grid: grids[i]), cg, nil)
            }
        }
        var fields: [BoomField] = []
        var backdrops: [Int: CGImage] = [:]
        var buffers: [Int: BoomCaptureBuffer] = [:]
        var radius: CGFloat = 0
        for (i, d) in disps.enumerated() {
            var color = [UInt32](repeating: 0, count: grids[i].cols * grids[i].rows)
            if let dec = decoded[i] {
                color = dec.color
                backdrops[fields.count] = dec.image
                buffers[fields.count] = dec.buffer
            }
            fields.append(BoomField(grid: grids[i], originCG: CGPoint(x: d.x, y: d.y),
                                    color: color))
            for c in [CGPoint(x: d.x, y: d.y), CGPoint(x: d.x + d.w, y: d.y),
                      CGPoint(x: d.x, y: d.y + d.h), CGPoint(x: d.x + d.w, y: d.y + d.h)] {
                radius = max(radius, hypot(c.x - origin.x, c.y - origin.y))
            }
        }
        // No captured images at all (e.g. Screen Recording was denied when
        // the helper armed): a boom over pure black isn't a show — start the
        // saver normally instead.
        guard !fields.isEmpty, !backdrops.isEmpty else { return nil }

        let core = BoomCore(
            params: BoomCore.Params(originCG: origin, radius: max(radius, 1),
                                    seed: UInt64(abs(capturedAt * 1000)) | 1,
                                    codeLines: codeLines()),
            fields: fields)
        let session = BoomSession(core: core, backdrops: backdrops,
                                  backdropBuffers: buffers, kind: kind,
                                  verb: verbs.randomElement(using: &saverRNG) ?? "Idling")
        shared = session
        BoomDiag.log(String(format: "session load: kind=%@ displays=%d mapped-raw=%d took %.1f ms",
                            kind.rawValue, fields.count, buffers.count,
                            (CACurrentMediaTime() - loadStart) * 1000))
        return session
    }
}

// MARK: - View

@objc(CodeSaverView)
public final class CodeSaverView: ScreenSaverView {

    // Spinner glyph frames; a cosine phase sweeps the index 0→5→0.
    private static let spinnerFrames =
        ["\u{B7}", "\u{2722}", "\u{2733}", "\u{2736}", "\u{273B}", "\u{273D}"]

    // MARK: Palette

    // Pure black: borderless on OLED/miniLED — the code floats on nothing.
    private let bgColor = NSColor.black
    private let codeBase = NSColor(deviceRed: 0.58, green: 0.65, blue: 0.72, alpha: 1)
    private let glowText = NSColor(deviceRed: 0.93, green: 0.98, blue: 1.0, alpha: 1)
    private let glowHalo = NSColor(deviceRed: 0.50, green: 0.83, blue: 1.0, alpha: 1)
    private let cursorColor = NSColor(deviceRed: 0.66, green: 0.90, blue: 1.0, alpha: 1)
    // Accent: bluish-purple (ref #6E49E4, Display P3), lifted a touch for
    // text legibility on the dark background.
    private let accent = NSColor(displayP3Red: 0.494, green: 0.357, blue: 0.937, alpha: 1)
    private let accentHot = NSColor(displayP3Red: 0.75, green: 0.64, blue: 1.0, alpha: 1)
    /// Swaps part of the session subset for freshly drawn blocks. Slots are
    /// chosen without replacement so `fraction` means what it says.
    private func rotateSubset(fraction: Double) {
        guard corpusData != nil, !fullIndex.isEmpty, blockRefs.count >= 8 else { return }
        let fresh = chooseSubset(budget: max(8, Int(Double(blockRefs.count) * fraction)))
        let slots = Array(0..<blockRefs.count).shuffled(using: &saverRNG).prefix(fresh.count)
        for (slot, r) in zip(slots, fresh) {
            blockRefs[slot] = r
            decodedBlocks[slot] = nil
        }
    }

    /// Lazily decodes one block of corpus.bin into lines.
    private func blockLines(at slot: Int) -> [String] {
        if let cached = decodedBlocks[slot] { return cached }
        guard let data = corpusData else { return [] }
        let r = blockRefs[slot]
        guard r.lowerBound >= 0, r.upperBound <= data.count else { return [] }
        var lines = String(decoding: data.subdata(in: r), as: UTF8.self)
            .components(separatedBy: "\n")
        if lines.last?.isEmpty == true { lines.removeLast() }
        decodedBlocks[slot] = lines
        return lines
    }

    /// Last resort, for a build that somehow ships without the sample.
    private static let fallbackCorpus = """
    func animateOneFrame() {
        let t = CACurrentMediaTime()
        advance(by: t - lastWall)
        setNeedsDisplay(bounds)
    }
    """

    // MARK: Layout setup

    private func ensureSetup() {
        guard bounds.width > 8, bounds.height > 8 else { return }
        guard bounds.size != setupSize else { return }
        setupSize = bounds.size

        let base = isPreview ? 7.0 : clampd(Double(bounds.width) / 125.0, 11.5, 16.5)
        font = NSFont(name: "SFMono-Regular", size: base) ?? .monospacedSystemFont(ofSize: base, weight: .regular)
        uiFont = NSFont(name: "SFMono-Regular", size: base * 1.18) ?? .monospacedSystemFont(ofSize: base * 1.18, weight: .regular)
        uiBoldFont = NSFont(name: "SFMono-Semibold", size: base * 1.18) ?? .monospacedSystemFont(ofSize: base * 1.18, weight: .semibold)

        charW = ("M" as NSString).size(withAttributes: [.font: font!]).width
        lineH = ceil(base * 1.55)
        leftInset = max(18, bounds.width * 0.015)
        topInset = max(14, bounds.height * 0.02)
        rowCount = max(4, Int((bounds.height - topInset * 2) / lineH))
        cols = max(20, Int((bounds.width - leftInset * 2) / charW))

        cellWidthCache.removeAll()  // widths are ratios of the (new) font
        rows = Array(repeating: [], count: rowCount)
        // Nominal spawn bands across the width; chunks get jitter within them,
        // so no fixed column edges ever show.
        bandCount = isPreview ? 1 : max(1, Int((Double(cols) / 100.0).rounded()))
        bandWidth = cols / bandCount
        let writerCount = isPreview ? 2 : min(8, max(3, min(bandCount * 3, rowCount / 6)))
        writers = (0..<writerCount).map { _ in Writer() }
        for w in writers {
            respawn(w)
            w.pauseUntil = now + rand(0, 2.5)
        }
    }

    // MARK: Animation

    // The frame clock is a CADisplayLink pinned to 30 Hz — the display's
    // own beat, not a runloop timer. 30 divides the panel's refresh evenly,
    // so every displayed frame is exactly two vsyncs AND exactly two 60 Hz
    // sim ticks: perfectly even cell motion. (Runloop timers drift a few ms
    // per frame; floor'd against the 60 Hz sim grid that yielded 1/2/3-tick
    // frames — the jitter the eye catches on quantized motion.)
    private var displayLinkBox: Any?   // CADisplayLink (macOS 14+ class)
    private var legacyTimer: Timer?

    public override func animateOneFrame() {
        // The saver framework's own timer is one of the jittery clocks; its
        // callback is ignored — the display link drives.
    }

    /// Advances by wall-clock time and requests a redraw. Safe to call from
    /// multiple drivers: overlapping calls produce dt ≈ 0, not double speed.
    private var dtStats = (lo: 1.0, hi: 0.0, sum: 0.0, n: 0)
    /// The current frame's vsync-aligned timestamp (host time), so the sim
    /// clock steps on the display grid, not on jittery callback wall time.
    private var frameNow: Double = 0
    private func buildIdleLineQuad(_ frame: inout BoomMetalRenderer.FrameInput,
                                   typed: Int? = nil, shimmer: Double = 0,
                                   metal: BoomMetalRenderer, scale: CGFloat) {
        let text = idleLineString(typed: typed)
        let size = text.size()
        let origin = idleLineOrigin(for: size)
        // Detonation kinetics: a two-frame surge flash through the box and
        // a BLAST of ejecta out of it (below). The box itself stays put —
        // a shake on something this small read as a timid shudder.
        var surge: Float = 0
        if intro == .boom {
            let t = now - boomStart
            if t >= 0, t < 2.0 / 30 { surge = t < 1.0 / 30 ? 0.6 : 0.28 }
        }
        // The tooltip panel extends 14/8 past the text; +2 for the stroke.
        let pad = NSSize(width: 16, height: 10)
        let full = NSSize(width: size.width + pad.width * 2,
                          height: size.height + pad.height * 2)
        guard let img = rasterUI(size: full, scale: scale, {
            drawIdleLine(text, at: NSPoint(x: pad.width, y: pad.height))
        }) else { return }
        metal.setUITexture("idleline", image: img, always: true)
        let panelRect = CGRect(x: origin.x - pad.width, y: origin.y - pad.height,
                               width: full.width, height: full.height)
        frame.quads.append(.init(key: "idleline", rect: panelRect))
        if shimmer > 0 {
            // Electric block over the materializing glyph — steps with the
            // flicker slots.
            let gw = idleLineString(typed: 0).size().width
            frame.lateFills.append(BoomMetalRenderer.fill(
                NSRect(x: origin.x - 6, y: origin.y - 6,
                       width: gw + 12, height: size.height + 12),
                scale: scale, color: SIMD4(0.75, 0.64, 1.0, Float(shimmer))))
        }
        if surge > 0 {
            frame.lateFills.append(BoomMetalRenderer.fill(
                panelRect.insetBy(dx: -2, dy: -2),
                scale: scale, color: SIMD4(0.75, 0.64, 1.0, surge)))
        }
        // The blast: cell-blocks in the accent palette ejected from the
        // panel's perimeter, decelerating outward like debris. Everything
        // quantized — positions re-rolled per 30 Hz step, snapped to the
        // terminal lattice, a quarter of the blocks sitting out each step
        // (sparkle, not smear). White-hot for the first two frames.
        if intro == .boom, let core = boomCore {
            let t = now - boomStart
            if t >= 0, t < 0.7 {
                let g = core.fields[boomFieldIndex].grid
                let cw = g.charW, lh = g.lineH
                let step = (t * 30).rounded(.down) / 30
                let stepIx = Int(t * 30)
                let c = armedLineCenter
                let rx = Double(panelRect.width) / 2, ry = Double(panelRect.height) / 2
                for i in 0..<56 {
                    if boomCellNoise(i, stepIx, 0xE1A6) < 0.25 { continue }
                    let ang = boomCellNoise(i, 11, 0xE1A5) * 2 * .pi
                    // Contained blowout: short reach, full intensity — the
                    // violence is in the brightness, not the distance.
                    let reach = 40.0 + boomCellNoise(i, 23, 0xE1A5) * 90.0
                    let r0 = sqrt(pow(rx * cos(ang), 2) + pow(ry * sin(ang), 2))
                    let r = r0 + reach * (1 - exp(-step / 0.13))
                    let px = Double(c.x) + cos(ang) * r
                    let py = Double(c.y) + sin(ang) * r
                    let col = ((CGFloat(px) - g.leftInset) / cw).rounded(.down)
                    let row = ((CGFloat(py) - g.topInset) / lh).rounded(.down)
                    let fade = Float(max(0, 1 - step / 0.7))
                    let color: SIMD4<Float> = t < 4.0 / 30
                        ? SIMD4(1.0, 0.97, 1.0, 1.0)
                        : SIMD4(0.80, 0.70, 1.0, 0.95 * fade)
                    frame.lateFills.append(BoomMetalRenderer.fill(
                        NSRect(x: g.leftInset + col * cw, y: g.topInset + row * lh,
                               width: cw, height: lh),
                        scale: scale, color: color))
                }
            }
        }
    }

    private func buildClockQuad(_ frame: inout BoomMetalRenderer.FrameInput,
                                metal: BoomMetalRenderer) {
        guard let cache = ensureClockCache() else { return }
        metal.setUITexture("clock", image: cache.image)   // 1 Hz re-upload
        frame.quads.append(.init(key: "clock", rect: cache.blitRect,
                                 maskToWipedCells: intro == .boom))
        clockBottom = cache.bottom
    }
    /// 4 Hz: the on/off switch from the host app, the saved tuning's size,
    /// and the art grid from the daemon — or from the tuning window, which
    /// republishes on every knob turn.
    private func pollAlbumArt() {
        guard !Self.widgetsDisabled, now >= artPollAt else { return }
        artPollAt = now + 0.25
        let fm = FileManager.default
        guard let dir = CorpusStore.widgetsDirectory else { return }
        func mtime(_ u: URL) -> Date? {
            (try? fm.attributesOfItem(atPath: u.path))?[.modificationDate] as? Date
        }
        let sURL = dir.appendingPathComponent("settings.json")
        let sM = mtime(sURL)
        if sM != artSettingsMTime {
            artSettingsMTime = sM
            // Anything but "none" is on: a settings file still naming the
            // retired braille style reads as on, not off.
            if let d = try? Data(contentsOf: sURL),
               let o = (try? JSONSerialization.jsonObject(with: d)) as? [String: Any],
               let st = o["albumArtStyle"] as? String {
                artOn = st != "none"
            } else {
                artOn = false
            }
        }
        guard artOn else { return }
        // Compare the OPTIONAL: a deleted tuning file means "back to the
        // defaults", which is a size change like any other.
        let tM = AlbumArtTuning.url.flatMap(mtime)
        if tM != artTuningMTime {
            artTuningMTime = tM
            artParams = AlbumArtRamp.Params(json: AlbumArtTuning.load()["ramp"] ?? [:])
        }
        let aURL = dir.appendingPathComponent("albumart.json")
        let aM = mtime(aURL)
        guard aM != artMTime else { return }
        artMTime = aM
        artRowsCache = nil
        artFitCache = nil
        artGrid = nil
        artKey = ""
        guard let d = try? Data(contentsOf: aURL),
              let o = (try? JSONSerialization.jsonObject(with: d)) as? [String: Any],
              let key = o["key"] as? String else { return }
        artKey = key
        if let g = o["ramp"] as? [String: Any] { artGrid = AlbumArtGrid(json: g) }
    }

    /// The art box for a height budget: a cols × rows grid, shrunk — both
    /// together, so the cover stays square — when its natural height overruns
    /// the room. nil when even that would be a smudge; then the panel has no
    /// art box at all. The placeholder (sized from the saved tuning) and the
    /// fitted cover go through this SAME rule, which is what keeps the
    /// panel's width from jumping when the cover lands. Never scales the
    /// FONT: glyphs at a scaled size have a different advance and can never
    /// sit on the panel's cell grid — that was the misalignment.
    private func artBox(cols: Int, rows: Int, room: CGFloat) -> (cols: Int, rows: Int)? {
        guard cols > 0, rows > 0 else { return nil }
        let naturalH = AlbumArtGrid.rowStep(charW: charW) * CGFloat(rows)
        if naturalH <= room { return (cols, rows) }
        let s = room / max(1, naturalH)
        guard s >= 0.45 else { return nil }          // below this it's a smudge
        return (max(8, Int((CGFloat(cols) * s).rounded(.down))),
                max(4, Int((CGFloat(rows) * s).rounded(.down))))
    }

    /// Rasterize the art grid once per (track, font size); the cached rows
    /// are then drawn into the per-frame panel raster.
    private func albumArtRows(_ grid: AlbumArtGrid) -> [NSAttributedString] {
        if let c = artRowsCache, c.key == artKey, c.pt == font!.pointSize,
           c.cols == grid.cols {
            return c.rows
        }
        let rows = grid.attributedRows(baseFont: font!)
        artRowsCache = (artKey, font!.pointSize, grid.cols, rows)
        return rows
    }
    /// Terminal-style marquee: rest at the head, then one continuous lap —
    /// the text walks out on the left and, after a gap of blank cells, comes
    /// back in on the right — then rest again. Featured-artist credits
    /// routinely run past any sane panel width, and clipping them drops the
    /// collaborators entirely. The earlier walk-to-the-end-and-snap-back read
    /// The clock is the track's own, so a new track starts at rest instead of
    /// somewhere mid-lap.
    private func marqueeText(_ text: String, width: Int) -> String {
        let chars = Array(text)
        let cells = chars.map { widgetGlyph($0).cells }
        let total = cells.reduce(0, +)
        guard width > 0, total > width else { return text }
        let glyph = 0.13            // seconds per glyph
        let hold = 4.0              // rest at the head before each lap
        let gap = 7                 // blank cells between the tail and the head again
        // The ring is the text followed by the gap; a lap walks every glyph
        // of it once — a wide glyph is one step like any other.
        let ring = chars + Array(repeating: Character(" "), count: gap)
        let ringCells = cells + Array(repeating: 1, count: gap)
        let cycle = hold + Double(ring.count) * glyph
        let t = (now - npTrackSince).truncatingRemainder(dividingBy: cycle)
        let off = t < hold ? 0 : min(ring.count - 1, Int((t - hold) / glyph))
        var used = 0, out = ""
        for k in 0..<ring.count {
            let i = (off + k) % ring.count
            if used + ringCells[i] > width { break }
            used += ringCells[i]; out.append(ring[i])
        }
        return out
    }

    private func widgetTilde(_ path: String) -> String {
        let home = FileManager.default.homeDirectoryForCurrentUser.path
        return path.hasPrefix(home) ? "~" + path.dropFirst(home.count) : path
    }

    /// paints the two at different weights. A bare "~" or "/" — or a path
    /// truncated inside its last component — is all tail.
    private func widgetSplitLastDir(_ path: String) -> (String, String) {
        guard path.count > 1, let slash = path.lastIndex(of: "/") else { return ("", path) }
        return (String(path[...slash]), String(path[path.index(after: slash)...]))
    }

    // MARK: Cell widths — CJK and other wide glyphs on the panel grid

    /// Per-glyph (cells, kern) at the current font size. SF Mono's own glyphs
    /// are one cell and need no kern; anything it falls back for — CJK,
    /// fullwidth forms, emoji, even ♪ — is measured once and rounded to whole
    /// cells, with the kern that makes its advance exactly that many cells.
    /// Counting `String.count` put a Chinese title's right rail wherever the
    /// fallback glyphs happened to end; the panel is a grid, and every glyph
    /// has to sit on it.
    private var widgetGlyphCache: [Character: (cells: Int, kern: CGFloat)] = [:]
    private var widgetGlyphCachePt: CGFloat = 0

    private func widgetGlyph(_ ch: Character) -> (cells: Int, kern: CGFloat) {
        if ch.isASCII { return (1, 0) }
        if widgetGlyphCachePt != font!.pointSize {
            widgetGlyphCache = [:]
            widgetGlyphCachePt = font!.pointSize
        }
        if let g = widgetGlyphCache[ch] { return g }
        let w = NSAttributedString(string: String(ch), attributes: [.font: font!]).size().width
        // Ceil, never round: a Hangul syllable falls back at 1.40 cells, and
        // rounding handed it ONE — a negative kern that squeezed every
        // syllable over its neighbour. Same rule as the main grid's
        // cellWidth: a glyph gets at least the cells its advance covers,
        // capped at two (an emoji at 2.1 cells takes a terminal's two).
        let n = min(2, max(1, Int(ceil(w / charW - 0.05))))
        var kern = CGFloat(n) * charW - w
        if abs(kern) < 0.05 { kern = 0 }
        let g = (cells: n, kern: kern)
        widgetGlyphCache[ch] = g
        return g
    }

    /// Cells a string takes on the panel grid.
    private func widgetCells(_ s: String) -> Int { s.reduce(0) { $0 + widgetGlyph($1).cells } }

    /// The longest prefix / suffix of `s` that fits in `cells` cells.
    private func widgetPrefix(_ s: String, cells: Int) -> String {
        var used = 0, out = ""
        for ch in s {
            let n = widgetGlyph(ch).cells
            if used + n > cells { break }
            used += n; out.append(ch)
        }
        return out
    }
    private func widgetSuffix(_ s: String, cells: Int) -> String {
        var used = 0, out: [Character] = []
        for ch in s.reversed() {
            let n = widgetGlyph(ch).cells
            if used + n > cells { break }
            used += n; out.append(ch)
        }
        return String(out.reversed())
    }
    private func buildNowPlayingQuad(_ frame: inout BoomMetalRenderer.FrameInput,
                                     metal: BoomMetalRenderer, scale: CGFloat,
                                     wall: Double, mask: Bool) {
        guard let app = widgetFeed.npApp, !widgetFeed.npTitle.isEmpty,
              wall - widgetFeed.npTS < 15 else { return }
        // The panel is BUDGETED, never gated. Its ceiling is whichever sits
        // lower: a fixed share of the screen, or the bottom of the hero
        // statusline. The art then scales into whatever remains, so it can
        // never clip the statusline no matter how long the verb runs — the
        // old approach let a long verb make the art vanish entirely.
        let heroSize = spinnerAttributedString().size()
        let heroBottom = spinnerTextOrigin(for: heroSize).y + heroSize.height
            + uiFont.pointSize * 1.05 + lineH * 0.75
        let npMargin = lineH * 1.2
        let ceiling = max(bounds.height - npMaxLines * lineH, heroBottom)
            + lineH * 0.6
        let chromeH = lineH * 5 + 12
        guard bounds.height - npMargin - chromeH >= ceiling else { return }
        let base = font!
        let railC = NSColor(white: 0.26, alpha: 1)
        let labelC = NSColor(deviceRed: 0.31, green: 0.35, blue: 0.39, alpha: 1)
        let titleC = NSColor(deviceRed: 0.58, green: 0.65, blue: 0.72, alpha: 1)
        func run(_ c: NSColor) -> [NSAttributedString.Key: Any] {
            [.font: base, .foregroundColor: c]
        }

        let paused = widgetFeed.npState == "paused"
        // A change of state starts the wave: in from the edges when pausing,
        // out from the centre when resuming. The first sight of a track is
        // never animated — there is nothing to transition from.
        if npPauseKnown == nil {
            npPauseKnown = paused
        } else if npPauseKnown != paused {
            npPauseKnown = paused
            npPauseChangedAt = now
        }
        let title0 = widgetFeed.npTitle, artist0 = widgetFeed.npArtist
        // Without art the panel still needs some width; WITH art, the art box
        // alone decides it — and the box is there from a track's first frame,
        // sized from the saved tuning, so the width never jumps when the
        // cover lands. Track metadata never widens the panel — a long feature
        // credit used to stretch it halfway across the screen.
        var inner = min(60, max(40, max(widgetCells(title0), widgetCells(artist0)) + 6))
        // The track the panel is on. A change restarts the placeholder's
        // clock and forgets the reveal, so the next cover lands with its own.
        let key = "\(app)|\(title0)|\(artist0)"
        if key != npTrackKey {
            npTrackChanged = !npTrackKey.isEmpty
            npTrackKey = key
            npTrackSince = now
            artShownSince = nil
            artFXCache = nil
        }
        var box: (cols: Int, rows: Int)?
        var grid: AlbumArtGrid?
        if artOn {
            let room = bounds.height - npMargin - chromeH - ceiling
            if artKey == key, let g = fittedArtGrid(room: room) {
                grid = g
                box = (g.cols, g.rows)
                if artShownSince == nil { artShownSince = now }
            } else {
                box = artBox(cols: artParams.colCount, rows: artParams.rowCount, room: room)
                artShownSince = nil
            }
            if let box { inner = max(24, box.cols + 3) }
        }
        // Title and artist both scroll when they overrun the field — bounded
        // by the art-derived width instead of being allowed to set it, and a
        // clipped title lost the half that names the song.
        let field = max(4, inner - 3)
        let title = marqueeText(title0, width: field)
        let artist = marqueeText(artist0, width: field)

        func timeMS(_ v: Double) -> String {
            let s = max(0, Int(v)); return "\(s / 60):" + String(format: "%02d", s % 60)
        }
        // Paused: the clock stops where the player stopped it.
        let pos = min(widgetFeed.npDur,
                      paused ? widgetFeed.npPos : widgetFeed.npPos + (wall - widgetFeed.npTS))
        let posS = timeMS(pos), durS = timeMS(widgetFeed.npDur)
    /// Advances the simulation clock. Exposed for the preview/snapshot harness.
    public func advance(by dt: Double) {
        now += dt
        ensureSetup()
        guard !rows.isEmpty else { return }
        if now >= nextPrefsRead {
            readPrefs()
            nextPrefsRead = now + 2
        }
        if !handoffChecked, window != nil { attachBoomSession() }
        // Session runs re-derive their clock from the shared monotonic anchor
        // every frame — all displays in lockstep even across dropped frames.
        // (Pre-anchor the clock holds still, so the scene freezes until every
        // display has staged; see BoomSession.markReady.)
        if let session = boomSession, intro != .none {
            rebindFieldIfNeeded(session)
            session.pollReadiness()
            let t = session.simTime(at: frameNow > 0 ? frameNow : CACurrentMediaTime())
            if intro == .armed { armEndsAt = now - t } else { boomStart = now - t }
        }
        switch intro {
        case .armed:
            // The captured desktop + the idle line; the scene holds its breath.
            if now >= armEndsAt { detonate() } else { return }
        case .boom:
            if let core = boomCore {
                // Local runs (preview click / env): dilate by drifting the
                // epoch so (now - boomStart) grows at 1/scale. Session runs
                // dilate at the source (BoomSession.simTime).
                if boomSession == nil, Self.boomTimeScale != 1 {
                    boomStart += dt * (1 - 1 / Self.boomTimeScale)
                }
                // Cap the catch-up target: past duration+6 the field is fully
                // transitioned and finishIntro (below) fires off the wall
                // clock anyway. Without the cap, a frame clock that stalls
                // mid-boom (display sleep) and resumes minutes later would
                // replay every missed tick — thousands of full-grid steps in
                // one frame.
                core.advance(to: min(now - boomStart, core.duration + 6))
                _ = core.drainPaints(boomFieldIndex)
                // Preview runs own every field; in a session each display's
                // view drains its own.
                if boomSession == nil {
                    for i in core.fields.indices where i != boomFieldIndex {
                        _ = core.drainPaints(i)
                    }
                }
                // The handoff waits for the debris: every flung glyph gets
                // its own bright-block → settled → fade lifecycle. Ending on
                // the fixed clock guillotined whichever heads were still
                // drifting — they all blipped out in one frame.
                let boomT = now - boomStart
                if boomT > core.duration + 1.0,
                   !core.particles.contains(where: { !$0.settled })
                       || boomT > core.duration + 5.0 {
                    finishIntro()
                }
            } else {
                intro = .none
            }
        case .none:
            break
        }
        // ↑ prefill — data streaming to the model — surges the typing, scaled
        // by how hard the counter is climbing. Tool runs slow to a visible
        // 0.5× — not the full crawl, which is reserved for the spinner's rest
        // and a new turn waiting on the API.
        let streaming = phase == .working && now - phaseStart >= parenDelay
        let targetMul: Double = !streaming ? 0.22
            : step == .toolWait ? 0.5
            : arrowIsDown ? 1.0 : prefillSurge
        speedMul += (targetMul - speedMul) * min(1, dt * 1.5)
        for w in writers { update(w, dt: dt) }
        updateSpinner(dt: dt)
        // Boom debris that has faded out is done for good.
        if now >= nextFadePurge {
            nextFadePurge = now + 3
            for i in rows.indices {
                rows[i].removeAll { $0.fading && now - $0.settledAt > BoomCore.settledFadeLife + 1 }
            }
        }
    }

    private var nextFadePurge: Double = 0

    // MARK: Background writers
    /// CODESAVER_BOOM="x,y[,armSeconds]" (x/y as fractions) arms the intro at
    /// launch — the snapshot harness's deterministic trigger.
    private func configureIntroFromEnv() {
        guard let spec = ProcessInfo.processInfo.environment["CODESAVER_BOOM"] else { return }
        // Strict: every field must parse, in place. Dropping a bad field and
        // reading the survivors positionally armed the boom at the wrong
        // point with the wrong countdown, silently — the one thing a
        // deterministic snapshot trigger must never do.
        let fields = spec.split(separator: ",", omittingEmptySubsequences: false)
            .map { Double($0.trimmingCharacters(in: .whitespaces)) }
        guard (2...3).contains(fields.count),
              fields.allSatisfy({ $0.map(\.isFinite) == true }) else {
            viewLog.error("CODESAVER_BOOM=\"\(spec, privacy: .public)\" is not \"x,y[,armSeconds]\" — intro not armed")
            return
        }
        let parts = fields.compactMap { $0 }
        armIntro(atNormalized: CGPoint(x: parts[0], y: parts[1]),
                 countdown: parts.count >= 3 ? parts[2] : 2.0)
    }

    /// Production path: the igniter left a capture manifest (screenshots +
    /// mouse position + trigger kind); the shared BoomSession loads it once
    /// and every display's view attaches. Idle triggers play a 5-second
    /// armed pre-animation over the captured desktop; hot-corner triggers
    /// detonate immediately. No manifest (or a stale one) → normal start.
    private func attachBoomSession() {
        handoffChecked = true
        guard intro == .none, let win = window, bounds.width > 8 else { return }
        guard let session = BoomSession.loadIfNeeded(codeLines: { self.boomCodeLines() },
                                                     verbs: verbs.map(\.ing)) else { return }
        let wo = win.frame.origin
        // A view that turns up after the show is over (a display hot-plugged
        // or woken mid-session: the host builds it a fresh view, and the
        // cached session is still the activation's) has nothing to replay —
        // stepping the shared core through every missed tick would stall the
        // whole process for seconds per minute of age. It starts as the
        // ordinary saver, which is exactly where the others already are.
        let t = session.simTime
        if t > session.core.duration + 5 {
            BoomDiag.log(String(format: "%@ attach: session %.0f s old — boom over, plain saver",
                                diagID, t))
            return
        }
        // Which field is ours: appex service windows sit at their display's
        // CG origin (see clockVisible). No field for this origin (or for the
        // window's screen) means the manifest never described this display:
        // it is not one of the show's, so it never binds a field — binding
        // it to field 0 regardless would only make it a second claimant on
        // the main display, refused every frame and holding black for it.
        guard let idx = fieldIndex(in: session, for: win) else {
            BoomDiag.log(String(format: "%@ attach: window origin (%.0f, %.0f) matches no field — plain saver",
                                diagID, wo.x, wo.y))
            return
        }
        boomFieldIndex = idx
        boomSession = session
        boomCore = session.core
        BoomDiag.log(String(format: "%@ attach: window origin (%.0f, %.0f) → field %d, simTime %.2f",
                            diagID, wo.x, wo.y, boomFieldIndex, session.simTime))
        viewOriginCG = session.core.fields[boomFieldIndex].originCG
        let fieldSize = session.core.fields[boomFieldIndex].grid.size
        boomOriginNorm = CGPoint(
            x: (session.core.params.originCG.x - viewOriginCG.x) / fieldSize.width,
            y: (session.core.params.originCG.y - viewOriginCG.y) / fieldSize.height)
        armedVerb = session.verb
        for i in rows.indices { rows[i] = [] }
        if t < 0 {
            intro = .armed
            armEndsAt = now - t
            armTotal = session.armDuration
        } else {
            detonate(start: now - t)
        }
    }

    /// The session field a window belongs to: by frame origin first (where
    /// the host puts service windows), else by the window's screen — nil
    /// when the display is not one the manifest captured.
    private func fieldIndex(in session: BoomSession, for win: NSWindow) -> Int? {
        let wo = win.frame.origin
        if let i = session.core.fields.firstIndex(where: {
            abs($0.originCG.x - wo.x) < 0.5 && abs($0.originCG.y - wo.y) < 0.5
        }) { return i }
        guard let screen = win.screen,
              let num = screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? CGDirectDisplayID
        else { return nil }
        let b = CGDisplayBounds(num)
        return session.core.fields.firstIndex {
            abs($0.originCG.x - b.origin.x) < 0.5 && abs($0.originCG.y - b.origin.y) < 0.5
        }
    }
        let gridW = colSeg.count
        // The time element is [1 leading blank][digits][AM/PM] — the blank
        // counterweights the 2-col meridian — and symmetric padding wraps the
        // whole element.
        let lead = suffix.isEmpty ? 0 : 1
        let elementW = lead + gridW + suffix.count
        let inner = max(elementW + Int(clockPadCells) * 2, dateStr.count + 4)
        let leftPad = (inner - elementW) / 2 + lead
        let rightPad = inner - elementW - (leftPad - lead)

        // Height-derived cells can overflow a narrow (portrait) screen —
        // shrink the font so the box always fits the width.
        let maxBoxW = bounds.width * 0.88
        let boxCols = CGFloat(inner + 2)
        if boxCols * charW > maxBoxW {
            f = monoFont(h * clockScale * maxBoxW / (boxCols * charW), .regular)
            charW = ("\u{2588}" as NSString).size(withAttributes: [.font: f]).width
            step = (f.ascender - f.descender) * 0.9
        }

        // Opaque colors: rows overlap slightly to avoid seams, and translucent
        // glyphs would double-composite into visible bands where they do.
        // Colon/seconds derive from digit brightness to keep the hierarchy.
        let borderC = NSColor(white: clockBorderWhite, alpha: 1)
        let dateC = NSColor(deviceRed: 0.31, green: 0.35, blue: 0.39, alpha: 1)
        let cellC: [Seg: NSColor] = [
            .digit: NSColor(white: clockDigitWhite, alpha: 1),
            .colon: NSColor(white: clockDigitWhite * 0.48, alpha: 1),
            .seconds: NSColor(white: clockDigitWhite * 0.63, alpha: 1),
            .gap: .clear,
        ]

        func run(_ s: String, _ color: NSColor) -> NSAttributedString {
            NSAttributedString(string: s, attributes: [.font: f, .foregroundColor: color, .shadow: scrim])
        }

        var rows: [NSAttributedString] = []

        // Heavy box drawing, square corners; date centered in the top rail.
        let top = NSMutableAttributedString()
        let dateFill = max(0, inner - dateStr.count - 2)
        let dateLeft = dateFill / 2
        top.append(run("\u{250F}" + String(repeating: "\u{2501}", count: dateLeft) + " ", borderC))
        top.append(run(dateStr, dateC))
        top.append(run(" " + String(repeating: "\u{2501}", count: dateFill - dateLeft) + "\u{2513}", borderC))
        rows.append(top)

        let emptyRow = run("\u{2503}" + String(repeating: " ", count: inner) + "\u{2503}", borderC)
        for _ in 0..<clockVPadRows { rows.append(emptyRow) }

        // 5 grid rows → 3 text rows of half-blocks.
        for tr in 0..<3 {
            let topBits = Array(grid[tr * 2])
            let botBits = tr * 2 + 1 < 5 ? Array(grid[tr * 2 + 1]) : Array(repeating: Character("0"), count: gridW)
            let line = NSMutableAttributedString()
            line.append(run("\u{2503}" + String(repeating: " ", count: leftPad), borderC))
            for i in 0..<gridW {
                let t = topBits[i] == "1", b = botBits[i] == "1"
                let ch = t && b ? "\u{2588}" : t ? "\u{2580}" : b ? "\u{2584}" : " "
                line.append(run(ch, cellC[colSeg[i]] ?? .white))
            }
            if !suffix.isEmpty {
                // AM/PM occupies the bottom text row only.
                line.append(tr == 2
                    ? run(suffix, NSColor(white: 0.44, alpha: 1))
                    : run(String(repeating: " ", count: suffix.count), borderC))
            }
            line.append(run(String(repeating: " ", count: rightPad) + "\u{2503}", borderC))
            rows.append(line)
        }

        for _ in 0..<clockVPadRows { rows.append(emptyRow) }

        rows.append(run("\u{2517}" + String(repeating: "\u{2501}", count: inner) + "\u{251B}", borderC))

        let boxW = CGFloat(inner + 2) * charW
        let x0 = (bounds.width - boxW) / 2
        let topY = h * clockTopFrac
        let backdrop = NSRect(x: x0 - charW * 0.6, y: topY - step * 0.25,
                              width: boxW + charW * 1.2, height: CGFloat(rows.count) * step + step * 0.5)
        // Padding around the cached raster so the scrim halos aren't clipped.
        let pad = h * 0.045
        guard let image = Self.rasterizeClock(
            rows: rows, backdropSize: backdrop.size, pad: pad, step: step,
            inset: NSPoint(x: charW * 0.6, y: step * 0.25),
            backdropAlpha: clockBackdropAlpha, scale: scale
        ) else { return nil }
        return ClockCache(key: key, image: image,
                          blitRect: backdrop.insetBy(dx: -pad, dy: -pad),
                          bottom: topY + CGFloat(rows.count) * step)
    }
//
//  CodeSaverViewController.swift
//  CodeSaverExtension
//
//  Copyright © 2026 Guillaume Louel. Licensed under the MIT License.
//
//  Main view controller for the screensaver. Specified as
//  ScreenSaverViewControllerClass in Info.plist as
//  `$(PRODUCT_MODULE_NAME).CodeSaverViewController`.
//
//  Mirrors Apple's Arabesque.appex pattern: only override the standard
//  init(nibName:bundle:), init(coder:), and loadView(); let the framework
//  drive everything else.
//

import AppKit
import ScreenSaver

private let logger = AppexLog.logger("ViewController")

@objc(CodeSaverViewController)
class CodeSaverViewController: ScreenSaverViewController {

    /// Strong reference so the framework can't drop our view while we still own it.
    private var saverView: CodeSaverView?

    override init(nibName nibNameOrNil: NSNib.Name?, bundle nibBundleOrNil: Bundle?) {
        logger.info("init(nibName:bundle:)")
        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)
    }

    required init?(coder: NSCoder) {
        logger.info("init(coder:)")
        super.init(coder: coder)
    }

    deinit {
        logger.info("deinit")
    }

    /// Called by the framework to create the view.
    ///
    /// Deliberately the plain loadView() override, matching Apple's own appex
    /// savers (Arabesque et al.) — overriding the private
    /// loadView(forFrame:isPreview:) hook instead replaces framework hosting
    /// setup its base implementation performs, and the saver renders black
    /// (learned the hard way). The cost: the System Settings preview renders
    /// at full-screen metrics rather than as a true miniature.
    override func loadView() {
        let frame = NSScreen.main?.frame ?? NSRect(x: 0, y: 0, width: 1920, height: 1080)
        logger.notice("loadView() — initial frame \(Double(frame.width), privacy: .public)×\(Double(frame.height), privacy: .public)")
        let view = CodeSaverView(frame: frame, isPreview: false)
        saverView = view
        self.view = view ?? NSView(frame: frame)
    }
}
#!/bin/zsh
# Build CodeSaver.app (+ embedded CodeSaverExtension.appex) and install to
# /Applications, registering the appex with pluginkit. The code corpus is no
# longer baked at build time — the installed app fetches it from GitHub into
# the app-group container (connect GitHub once in the app).
set -euo pipefail
cd "$(dirname "$0")"

SIGN_ID="${SIGN_ID:-Apple Development}"
# Team ID: env override, else detect from the signing certificate. The
# `|| true` matters: without it, pipefail+errexit silently kills the script
# on machines with no certificate — before the friendly error below.
TEAM_ID="${TEAM_ID:-$(security find-certificate -c "$SIGN_ID" -p 2>/dev/null \
  | openssl x509 -noout -subject 2>/dev/null \
  | sed -n 's/.*OU *= *\([A-Z0-9]*\).*/\1/p' || true)}"
[[ -n $TEAM_ID ]] || { echo "no signing team — need an 'Apple Development' certificate (a free Apple ID via Xcode → Settings → Accounts works)"; exit 1; }

echo "── building…"
mkdir -p build  # tee opens its log before xcodebuild creates the directory
# Build number = install timestamp (overrides BuildNumber.xcconfig without
# touching the tracked file), so "which build is installed?" has an answer.
BUILD_NUM="$(date +%y%m%d.%H%M)"
xcodebuild -project CodeSaver.xcodeproj -scheme CodeSaver -configuration Release \
  -derivedDataPath build \
  CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY="$SIGN_ID" DEVELOPMENT_TEAM="$TEAM_ID" \
  CURRENT_PROJECT_VERSION="$BUILD_NUM" \
  build 2>&1 | tee build/xcodebuild.log | tail -3 \
  || { echo "build failed — full log: appex/build/xcodebuild.log"; exit 1; }

APP=build/Build/Products/Release/CodeSaver.app
[[ -d $APP ]] || { echo "build product missing"; exit 1; }

# Migrate away from the legacy .saver if it's still installed.
rm -rf "$HOME/Library/Screen Savers/CodeSaver.saver"

# Replace any previous install, then register. One location only (/Applications):
# pluginkit caches discovery paths and prefers /Applications, so never register
# the DerivedData copy. Stage first so a failed copy can't destroy a working
# install.
STAGING="/Applications/.CodeSaver.staging.app"
rm -rf "$STAGING"
ditto "$APP" "$STAGING"
if [[ -d /Applications/CodeSaver.app ]]; then
  pluginkit -r /Applications/CodeSaver.app/Contents/PlugIns/CodeSaverExtension.appex 2>/dev/null || true
  rm -rf /Applications/CodeSaver.app
fi
mv "$STAGING" /Applications/CodeSaver.app
pluginkit -a /Applications/CodeSaver.app/Contents/PlugIns/CodeSaverExtension.appex \
  || echo "── pluginkit registration failed (macOS's /Applications scan usually picks it up anyway)"

# macOS auto-scans the DerivedData build folder and re-registers the freshly
# built appex there, clobbering the /Applications registration (the "pick ONE
# location" trap from AppexSaverMinimal's README). Unregister and delete the
# build copy so it can never win.
pluginkit -r "$APP/Contents/PlugIns/CodeSaverExtension.appex" 2>/dev/null || true
rm -rf "$APP" "$(dirname "$APP")/CodeSaverExtension.appex"

# Reinstalling breaks the active screen-saver selection (the wallpaper store's
# binding goes stale with the new bundle), so re-activate unless told not to.
# Activation races pluginkit registration right after install — an unbound
# selection makes the saver launch as pure black — so retry with the
# registration nudged in between.
if [[ ${NO_ACTIVATE:-0} != 1 ]]; then
  # Wait for pluginkit to actually list the /Applications appex — under load
  # registration can take well over the old 2 s — re-adding it each round.
  APPEX=/Applications/CodeSaver.app/Contents/PlugIns/CodeSaverExtension.appex
  for attempt in $(seq 1 10); do
    pluginkit -a "$APPEX" 2>/dev/null || true
    sleep 1.5
  done
    || echo "── WARNING: pluginkit does not list the installed appex yet"
  ACTIVATED=0
  for attempt in 1 2 3 4 5; do
    if /Applications/CodeSaver.app/Contents/MacOS/CodeSaver --activate 2>/dev/null; then
      ACTIVATED=1
      break
    fi
    pluginkit -a "$APPEX" 2>/dev/null || true
    sleep 2
  done
  if [[ $ACTIVATED == 1 ]]; then
    echo "── re-activated as the current screensaver"
  else
    # Loud, and fatal: an unbound selection means macOS quietly shows one of
    # its own savers instead. This is not a warning to scroll past.
    echo "!! AUTO-ACTIVATION FAILED — the system screensaver selection is now unbound."
    echo "!! Run: /Applications/CodeSaver.app/Contents/MacOS/CodeSaver --activate"
    echo "!! or click “Enable as Screensaver” in the app."
    exit 1
  fi
fi
# (Re-)register the corpus refresh LaunchAgent now that the app sits at its
# stable /Applications path; a no-op when already enabled. RunAtLoad gives a
# first corpus fetch right away once a token is present. The widget feeds
# agent is opt-in (the app's "Live widgets" switch): this re-registers it
# only if it was already on, and never turns it on for a fresh install.
/Applications/CodeSaver.app/Contents/MacOS/CodeSaver --register-agent 2>/dev/null \
  || echo "── agent registration failed — toggle “Auto-refresh” in the app"

# The feeds daemon is KeepAlive: it survived the bundle swap above on the
# unlinked inode, and re-registering an already-enabled agent never re-execs
# it — nor does it reload the plist, so a changed ProcessType would never
# take effect. Unregister + register loads the bundle's current plist and
# starts the daemon on the new build; the kickstart is the fallback for a
# job that was left loaded but not running. Both only when the agent is on:
# --reregister-feeds exits 0 without registering for a user who never
# switched Live widgets on, and the launchctl checks then find no job.
# (The refresh agent needs none: StartInterval re-execs it every hour.)
FEEDS_LABEL="$(/usr/libexec/PlistBuddy -c 'Print :Label' \
if /Applications/CodeSaver.app/Contents/MacOS/CodeSaver --reregister-feeds 2>/dev/null; then
  echo "── feeds daemon re-registered from the bundle's plist"
fi
sleep 1
if launchctl print "gui/$(id -u)/$FEEDS_LABEL" 2>/dev/null | grep -q "state = running"; then
  echo "── feeds daemon running on the new build"
elif launchctl kickstart -k "gui/$(id -u)/$FEEDS_LABEL" 2>/dev/null; then
  echo "── restarted the feeds daemon on the new build"
else
  echo "── feeds daemon off (opt in with “Live widgets” in the app)"
fi

echo "── installed /Applications/CodeSaver.app"
pluginkit -m -v -p com.apple.screensaver 2>/dev/null | grep -i codesaver || echo "   (not yet visible to pluginkit — System Settings usually picks it up shortly)"
echo "   Pick “CodeSaver” in System Settings → Screen Saver."
#!/bin/zsh
# Build the windowed preview / snapshot harness (the tuning workflow):
#   ./build.sh
#   ./build/preview                            live window + tuning panel
#   ./build/preview --snapshot <dir> <t1> <t2>…  offscreen PNG frames
#
# The harness reads the corpus + verbs CodeSaver.app maintains in the
# app-group container (CODESAVER_RESOURCES overrides, e.g. for video renders).
set -euo pipefail
cd "$(dirname "$0")"

mkdir -p build
echo "── compiling preview harness…"
swiftc -O -parse-as-library -module-name CodeSaverPreview \
  appex/CodeSaverExtension/CodeSaverView.swift \
  appex/CodeSaverExtension/BoomCore.swift \
  appex/CodeSaverExtension/BoomMetal.swift \
  appex/CodeSaver/Helpers/Logger.swift \
  appex/CodeSaver/CorpusStore.swift \
  appex/CodeSaver/AlbumArtShared.swift \
  appex/CodeSaver/AlbumArtRamp.swift \
  Sources/PreviewMain.swift \
  -framework ScreenSaver -framework AppKit -framework QuartzCore -framework Metal \
  -framework ScreenCaptureKit -framework ImageIO -framework IOKit \
  -o build/preview
echo "── built build/preview  (run it for a live window)"

# --- Igniter helper (idle watcher → boom → screensaver) ----------------------
echo "── compiling igniter helper…"
swiftc -O -parse-as-library helper/Igniter.swift \
  -framework AppKit -framework IOKit -framework ScreenCaptureKit \
  -o build/codesaver-igniter
echo "── built build/codesaver-igniter  (helper/install.sh installs the LaunchAgent)"

# --- Feed merge check (the daemon's merge on fabricated files, in a temp dir) -
echo "── compiling feed check…"
swiftc -O -parse-as-library -module-name FeedsCheck \
  appex/CodeSaver/FeedsService.swift \
  appex/CodeSaver/CorpusStore.swift \
  appex/CodeSaver/AlbumArtShared.swift \
  appex/CodeSaver/AlbumArtRamp.swift \
  appex/CodeSaver/Helpers/Logger.swift \
  Sources/FeedsCheck.swift \
  -framework AppKit -framework ServiceManagement -framework ImageIO \
  -o build/feeds-check
echo "── built build/feeds-check  (run it: never touches ~/.claude or the real feed)"

# --- Marquee tuner (standalone window for the now-playing title roll) --------
echo "── compiling marquee tuner…"
swiftc -O -parse-as-library Sources/MarqueeTuner.swift -framework AppKit -o build/marquee-tuner
echo "── built build/marquee-tuner  (opens in a second; writes build/marquee-tuning.json)"
def to_lin(a):
    return np.where(a <= 0.04045, a / 12.92, ((a + 0.055) / 1.055) ** 2.4)


def to_srgb(a):
    a = np.clip(a, 0.0, 1.0)
    return np.where(a <= 0.0031308, a * 12.92, 1.055 * a ** (1 / 2.4) - 0.055)


def sample_rgb(path, cols, rows):
    """Area-average each cell in LINEAR light -> (rows, cols, 3).

    The cover's signature graphic is three ~6px white rules under CALVIN / HARRIS /
    18 MONTHS in a 27px-tall cell.  Averaged in gamma space they vanish and the
    sleeve stops being recognisable; linear light is the physically correct
    downscale and keeps them."""
    a = np.asarray(Image.open(path).convert("RGB"), dtype=np.float64) / 255.0
    lin = to_lin(a)
    h, w = lin.shape[:2]
    ys = (np.arange(rows + 1) * h) // rows
    xs = (np.arange(cols + 1) * w) // cols
    out = np.empty((rows, cols, 3))
    for j in range(rows):
        band = lin[ys[j]:ys[j + 1]]
        for i in range(cols):
            out[j, i] = band[:, xs[i]:xs[i + 1]].reshape(-1, 3).mean(axis=0)
    return out


def unsharp(cells, amount):
    """Local-contrast boost on the CELL grid -- recovers edges the downsample softened."""
    if amount <= 0:
        return cells
    p = np.pad(cells, 1, mode="edge")
    blur = sum(p[j:j + cells.shape[0], i:i + cells.shape[1]]
               for j in range(3) for i in range(3)) / 9.0
    return cells + amount * (cells - blur)


def tone(rgb_lin, gamma=GAMMA, lo_pct=LO_PCT, hi_pct=HI_PCT, sharp=SHARP):
    """linear cell RGB -> t in 0..1, the tone every later decision is taken from."""
    v = unsharp(to_srgb(rgb_lin @ W709), sharp)
    lo, hi = np.percentile(v, lo_pct), np.percentile(v, hi_pct)
    return np.clip((v - lo) / max(hi - lo, 1e-6), 0.0, 1.0) ** gamma


def gamut_fit(chroma, Y):
    """Pull chroma toward the achromatic axis just far enough to fit in sRGB.

    Scaling chroma about 1.0 leaves dot(chroma, W709) == 1, so this never moves the
    cell's luma -- an out-of-gamut colour loses saturation, never brightness."""
    s = 1.0
    mx, mn = chroma.max(), chroma.min()
    if Y > 1e-9 and mx > 1.0 and mx * Y > 1.0:
        s = min(s, (1.0 / Y - 1.0) / (mx - 1.0))
    if mn < 0.0:
        s = min(s, 1.0 / (1.0 - mn))
    s = max(0.0, min(1.0, s))
    return 1.0 + s * (chroma - 1.0)


def render(rgb_lin, t, peak=PEAK, a_exp=A_EXP, k=K, sat=SAT):
    """-> glyph grid, colour grid.  Character from tone, colour from the artwork."""
    inks = np.array([c[1] for c in RAMP])
    idx = np.rint(t * (len(RAMP) - 1)).astype(int)
    Y_src = np.clip(rgb_lin @ W709, 1e-9, None)

    glyphs, colors = [], []
    for j in range(t.shape[0]):
        gr, cr = [], []
        for i in range(t.shape[1]):
            ch, a = RAMP[idx[j, i]]
            # colour luma: tone, then divided by the glyph's measured ink coverage
            comp = (A_REF / max(a, 1e-6)) ** k if a > 0 else 1.0
            v = min(peak * (t[j, i] ** a_exp) * comp, 255.0)
            Y = to_lin(np.array([v / 255.0]))[0]
            chroma = 1.0 + sat * (rgb_lin[j, i] / Y_src[j, i] - 1.0)
            rgb = gamut_fit(chroma, Y) * Y
            r, g, b = np.rint(to_srgb(rgb) * 255.0).astype(int)
            gr.append(ch)
            cr.append("#%02X%02X%02X" % (r, g, b))
        glyphs.append(gr); colors.append(cr)
    return glyphs, colors
def measure():
    """Re-derive the ink table.  Every number in RAMP came out of here."""
    from PIL import ImageDraw, ImageFont
    SS = 8
    font = ImageFont.truetype(FONT_PATH, FS * SS)
    asc, desc = font.getmetrics()
    top = (CH * SS - (asc + desc)) / 2.0
    cands = list(" .'`^\",:;-_~!|/\\+=<>*ilrcvxznuoshaeytkfjqpdbgw%&$#@"
                 "ABCDEFGHKMNOPQRSUVWXZ0123456789()[]{}") + list("░▒▁▂▃▄▅▆▇■□●○•·…∙")
    seen, out = set(), []
    for ch in cands:
        if ch in seen:
            continue
        seen.add(ch)
        W, H = CW * SS, CH * SS
        img = Image.new("L", (W, H), 0)
        ImageDraw.Draw(img).text((0, top), ch, font=font, fill=255)
        px = np.asarray(img, dtype=np.float64)
        cov, tot = px.mean() / 255.0, px.sum()
        cy = (px.sum(axis=1) @ np.arange(H)) / tot / H if tot else 0.5
        cx = (px.sum(axis=0) @ np.arange(W)) / tot / W if tot else 0.5
        out.append((cov, cy, cx, ch))
    out.sort()
    print(f"{'ink':>7}  {'cy':>4} {'cx':>4}  glyph   (centred = |cy-.5|<=.09 and |cx-.5|<=.09)")
    for cov, cy, cx, ch in out:
        flag = "  <-- centred" if abs(cy - .5) <= .09 and abs(cx - .5) <= .09 else ""
        print(f"{cov*100:6.2f}%  {cy:.2f} {cx:.2f}  {ch!r:6}{flag}")


if __name__ == "__main__":
    if "--measure" in sys.argv:
        measure(); sys.exit(0)

    assert all(RAMP[i][1] < RAMP[i + 1][1] for i in range(len(RAMP) - 1)), "ramp not monotonic"

    rgb = sample_rgb(SRC, COLS, ROWS)
    t = tone(rgb)

    if "--stats" in sys.argv:
        for p in (0, 5, 25, 50, 75, 95, 99, 100):
            print(f"tone p{p}: {np.percentile(t, p):.3f}")
        hist = np.bincount(np.rint(t * (len(RAMP) - 1)).astype(int).ravel(),
                           minlength=len(RAMP))
        for (ch, ink), n in zip(RAMP, hist):
            print(f"  {ch!r:5} ink={ink:5.2f}%  cells={n:4d}  {'#' * (n // 4)}")
        sys.exit(0)

    if "--probe" in sys.argv:
        variants = [("letters(19)", RAMP_LETTERS), ("shade(21)", list(RAMP)),
                    ("full(23)", RAMP_FULL)]
        blocks = []
        for name, rp in variants:
            for k in (0.00, 0.25, 0.42, 0.60):
                RAMP[:] = rp
                g, c = render(rgb, t, k=k, sat=1.40)
                blocks.append(f'<div class="lab">{name}  K={k:.2f}</div>'
                              '<pre>' + "\n".join(art_rows(g, c)) + '</pre>')
        with open("probe-color.html", "w") as f:
            f.write('<!doctype html><meta charset="utf-8"><style>'
                    'body{background:#000;margin:0;padding:16px;'
                    'font-family:"SF Mono",monospace;display:flex;flex-wrap:wrap;gap:18px}'
                    'pre{font-size:15px;line-height:18px;white-space:pre;margin:0}'
                    '.lab{color:#6a7784;font-size:12px;padding-bottom:4px}'
                    'div.cell{}</style>' +
                    "".join(f'<div>{b}</div>' for b in blocks))
        print("wrote probe-color.html", file=sys.stderr)
        sys.exit(0)

    glyphs, colors = render(rgb, t)

    if "--json" in sys.argv:
        # Machine mode for the CodeSaver feeds daemon: rows of glyphs plus
        # per-cell hex colors. The saver draws these directly.
        import json as _json
        print(_json.dumps({
            "style": "ramp",
            "cols": COLS, "rows": ROWS,
            "chars": ["".join(r) for r in glyphs],
            "colors": [[c for c in row] for row in colors],
        }))
        sys.exit(0)

    print(f"# {COLS}x{ROWS}  ramp={len(RAMP)} steps  gamma={GAMMA} unsharp={SHARP} "
          f"peak={PEAK:.0f} K={K} sat={SAT}")
    for r in glyphs:
        print("".join(r))
    emit_page(art_rows(glyphs, colors), "albumart-ramp-color.html")
    print("\nwrote albumart-ramp-color.html", file=sys.stderr)
#!/usr/bin/env python3
"""Claude Code -> CodeSaver session-state writer.

Registered (async) on ~10 hook events in ~/.claude/settings.json, and invoked
with --statusline from the statusline wrapper. Each call folds one event into
~/.claude/codesaver/sessions/<session_id>.json (atomic replace). The CodeSaver
feeds daemon (`CodeSaver --feeds`) merges these files with the pause and pin
mods' live state files (~/.claude/live) and mirrors the result into the
app-group container for the saver. The live file decides a session's state
when it has one; this file stays the base -- it alone sees permission
dialogs, and it covers sessions that don't load the mods.

Contract: NEVER write to stdout (UserPromptSubmit/SessionStart stdout is
injected into Claude's context), never exit non-zero, stay fast. Subagent
events (payload has agent_id) are ignored -- one state per session.
"""
import fcntl, json, os, sys, time, unicodedata

DIR = os.path.expanduser("~/.claude/codesaver/sessions")


def locked(sid):
    """Per-session advisory lock: the async hook writers and the 5s
    statusline writer race on the same file, and a stale read written back
    silently drops newer fields (lost hook_ts made dead sessions look
    heartbeat-fresh forever)."""
    os.makedirs(DIR, exist_ok=True)
    lk = open(os.path.join(DIR, f".{sid}.lock"), "w")
    fcntl.flock(lk, fcntl.LOCK_EX)
    return lk


def load(sid):
    # encoding= is explicit on every open here: the hook inherits whatever
    # environment Claude Code was launched from, and under LANG=C a bare
    # open() would pick a non-UTF-8 codec, blow up on a CJK cwd, and be
    # swallowed by the catch-all below -- the session would simply stop
    # updating, with nothing to show for it.
    try:
        with open(os.path.join(DIR, sid + ".json"), encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def store(sid, st):
    os.makedirs(DIR, exist_ok=True)
    tmp = os.path.join(DIR, f".{sid}.{os.getpid()}.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(st, f)
    os.replace(tmp, os.path.join(DIR, sid + ".json"))


def nfc(v):
    """Compose a path before it goes on the wire. A directory named in
    Hangul or kana arrives decomposed from an HFS+ volume (한 as three
    jamo), and the saver's panel measures its width one Character at a
    time -- a decomposed syllable counts as several."""
    return unicodedata.normalize("NFC", v) if isinstance(v, str) else v


def main():
    try:
        # Read bytes and decode UTF-8 ourselves rather than trusting
        # sys.stdin's locale-derived codec, for the same reason as above.
        data = json.loads(sys.stdin.buffer.read().decode("utf-8"))
    except Exception:
        return
    now = time.time()

    if "--statusline" in sys.argv:
        sid = data.get("session_id")
        if not sid:
            return
        lk = locked(sid)
        st = load(sid)
        st["session_id"] = sid
        st["cwd"] = nfc(data.get("cwd") or (data.get("workspace") or {}).get(
            "current_dir") or st.get("cwd"))
        st["model"] = (data.get("model") or {}).get("display_name") or st.get("model")
        cw = data.get("context_window") or {}
        out = cw.get("total_output_tokens")
        inp = cw.get("total_input_tokens")
        if isinstance(out, (int, float)):
            # Despite the names, both are PER-REQUEST: input is the last
            # request's prompt (= the live context size), output is the last
            # request's reply. Their sum is the context after the last
            # request, so "tokens this turn" is its growth since the prompt:
            # the daemon shows session_tokens - anchor_tokens.
            total = int(out) + (int(inp) if isinstance(inp, (int, float)) else 0)
            prev = st.get("session_tokens")
            if st.get("anchor_turn") != st.get("turn_started"):
                # Fallback anchor for a turn whose UserPromptSubmit predates
                # the hooks; the hook-side anchor (set at prompt time) wins.
                st["anchor_turn"] = st.get("turn_started")
                st["anchor_tokens"] = total
            elif isinstance(prev, int) and total < prev:
                # Context shrank mid-turn (compaction, tool-result clearing).
                # Slide the anchor down by the drop so growth-so-far carries
                # across and the count keeps rising from where it was.
                st["anchor_tokens"] = st.get("anchor_tokens", 0) - (prev - total)
            st["session_tokens"] = total
        st["sl_ts"] = now
        store(sid, st)
        lk.close()
        return
    if data.get("agent_id"):        # subagent event: not this session's state
        return
    sid = data.get("session_id")
    if not sid:
        return
    ev = data.get("hook_event_name") or ""
    lk = locked(sid)
    st = load(sid)
    st["session_id"] = sid
    if data.get("cwd"):
        st["cwd"] = nfc(data["cwd"])
    st["hook_ts"] = now
    pid = os.environ.get("CLAUDE_PID") or ""
    if pid.isdigit():               # the CLI's pid: the daemon checks liveness
        st["pid"] = int(pid)

    if ev == "SessionStart":
        # A resumed session (--resume / --continue keep the id) arrives
        # still marked "gone" by its own SessionEnd; left alone it stayed
        # invisible until the first prompt of the new run.
        if st.get("hook_state") in (None, "gone"):
            st["hook_state"] = "done"
        if data.get("model"):
            st["model"] = data["model"]
    elif st.get("hook_state") == "gone" and ev != "UserPromptSubmit":
        # SessionEnd's async siblings can land after it (a Stop or
        # MessageDisplay from the final turn): a straggler must not
        # resurrect a closed session as "done" for the next hour. Only
        # SessionStart above or a new turn's prompt reopens it.
        lk.close()
        return
    elif ev == "UserPromptSubmit":
        st["hook_state"] = "working"
        st["turn_started"] = now
        # Anchor the context size here, before this turn's first request
        # lands; the statusline branch would anchor one response too late.
        st["anchor_turn"] = now
        st["anchor_tokens"] = st.get("session_tokens", 0)
        st.pop("turn_ended", None)
        st.pop("bg", None)
    elif ev == "PreToolUse":
        st["hook_state"] = "waiting_tool"
        st["tool"] = data.get("tool_name") or "?"
    elif ev in ("PostToolUse", "PostToolUseFailure"):
        st["hook_state"] = "working"
    elif ev == "PermissionRequest":
        st["hook_state"] = "permission"
        st["tool"] = data.get("tool_name") or "?"
    elif ev == "MessageDisplay":
        # Async hooks don't execute in fire order: the final text's display
        # hook can run AFTER Stop already wrote "done". A straggler must
        # never resurrect the turn (a real new turn always begins with
        # UserPromptSubmit -> "working" first).
        if st.get("hook_state") == "done":
            lk.close()
            return
        st["hook_state"] = "responding"
    elif ev in ("Stop", "StopFailure"):
        st["hook_state"] = "done"
        st["turn_ended"] = now
        counts = {}
        for t in data.get("background_tasks") or []:
            k = t.get("type") or "task"
            counts[k] = counts.get(k, 0) + 1
        if counts:
            st["bg"] = counts
    elif ev == "SessionEnd":
        st["hook_state"] = "gone"
    else:
        lk.close()
        return                      # unknown event: change nothing
    store(sid, st)
    lk.close()


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass                        # never break a Claude Code session
#!/bin/bash
# CodeSaver statusline wrapper: passes the statusline JSON through to the
# statusline that was there before CodeSaver was wired in, unchanged, and
# tees it (in the background, so the bar's latency is untouched) into the
# CodeSaver state writer for session token counts / model / heartbeat.
#
# Installed by feeds/wire-settings.py, which also saves the previous
# statusline command as ~/.claude/codesaver/statusline-passthrough.sh. No
# saved command and no ~/.claude/statusline-command.sh means there was no
# statusline before: print nothing, and Claude Code shows none.
input=$(/bin/cat)
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
py="$(command -v python3 2>/dev/null || echo /usr/bin/python3)"
printf '%s' "$input" | "$py" "$here/cc-state-hook.py" --statusline >/dev/null 2>&1 &
passthrough="$HOME/.claude/codesaver/statusline-passthrough.sh"
if [[ -s "$passthrough" ]]; then
  printf '%s' "$input" | bash "$passthrough"
elif [[ -f "$HOME/.claude/statusline-command.sh" ]]; then
  printf '%s' "$input" | bash "$HOME/.claude/statusline-command.sh"
fi
#!/usr/bin/env python3
"""Wire Claude Code into CodeSaver's live session widgets.

Edits ~/.claude/settings.json so that Claude Code reports session state to
CodeSaver: the state-writer hook (cc-state-hook.py) on every session event,
and the statusline wrapper (cc-statusline-wrapper.sh) for the 5-second token
heartbeat. The wrapper passes the statusline you already had through
untouched -- it is saved as ~/.claude/codesaver/statusline-passthrough.sh.

    python3 feeds/wire-settings.py              install (idempotent)
    python3 feeds/wire-settings.py --dry-run    show the settings.json diff only
    python3 feeds/wire-settings.py --uninstall  remove the hooks, restore the statusline
    python3 feeds/wire-settings.py --dev        reference this checkout's scripts
                                                instead of copying them to
                                                ~/.claude/codesaver/bin

By default the two scripts are COPIED to ~/.claude/codesaver/bin so the
repo can move or go away afterwards (a prebuilt CodeSaver.app has no repo).
--dev points the hooks at the files right here, for hacking on the hook.

The state files land in ~/.claude/codesaver/sessions/; `CodeSaver --feeds`
(the LaunchAgent the app's "Auto-refresh" toggle registers) merges them into
the saver's feed. A backup of settings.json is kept next to it before every
change.
"""
import argparse, difflib, json, os, shutil, stat, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
HOOK = "cc-state-hook.py"
WRAPPER = "cc-statusline-wrapper.sh"
# Every event the hook folds into session state (see cc-state-hook.py).
EVENTS = [
    "SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse",
    "PostToolUseFailure", "PermissionRequest", "MessageDisplay", "Stop",
    "StopFailure", "SessionEnd",
]


def is_ours(cmd):
    return isinstance(cmd, str) and (HOOK in cmd or WRAPPER in cmd)


def load(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError as e:
        sys.exit(f"{path}: not valid JSON ({e}); fix it by hand first")


def dump(obj):
    return json.dumps(obj, indent=2, ensure_ascii=False) + "\n"


def write_atomic(path, text, mode=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)


def install_scripts(bin_dir, dev):
    """Where the hooks will point: the checkout (--dev) or fresh copies."""
    if dev:
        return os.path.join(HERE, HOOK), os.path.join(HERE, WRAPPER)
    os.makedirs(bin_dir, exist_ok=True)
    out = []
    for name in (HOOK, WRAPPER):
        dst = os.path.join(bin_dir, name)
        shutil.copyfile(os.path.join(HERE, name), dst)
        os.chmod(dst, os.stat(dst).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        out.append(dst)
    return tuple(out)


def wire(settings, hook_path, wrapper_path, python, codesaver_dir):
    """Return (new settings, side files to write) -- pure on `settings`."""
    s = json.loads(json.dumps(settings))
    hook_cmd = f"{python} {hook_path}"
    hooks = s.setdefault("hooks", {})
    for ev in EVENTS:
        groups = hooks.setdefault(ev, [])
        # Drop any earlier wiring of ours (a moved repo, a different python)
        # before adding the current one: one entry per event, ever.
        for g in groups:
            g["hooks"] = [h for h in g.get("hooks", []) if not is_ours(h.get("command"))]
        groups[:] = [g for g in groups if g.get("hooks")]
        groups.append({"hooks": [{"type": "command", "command": hook_cmd, "async": True}]})
    side = {}
    prev = s.get("statusLine")
    if not (isinstance(prev, dict) and is_ours(prev.get("command"))):
        # First wiring: keep what was there so the wrapper can pass it
        # through, and so --uninstall can put it back exactly.
        if isinstance(prev, dict) and prev.get("type") == "command" and prev.get("command"):
            side[os.path.join(codesaver_dir, "statusline-original.json")] = dump(prev)
            side[os.path.join(codesaver_dir, "statusline-passthrough.sh")] = (
                "#!/bin/bash\n# The statusline that was configured before CodeSaver was wired in;\n"
                "# cc-statusline-wrapper.sh pipes the statusline JSON through this.\n"
                f"{prev['command']}\n")
    s["statusLine"] = {"type": "command", "command": f"bash {wrapper_path}",
                       "refreshInterval": 5}
    return s, side


def unwire(settings, codesaver_dir):
    s = json.loads(json.dumps(settings))
    hooks = s.get("hooks", {})
    for ev in list(hooks):
        groups = hooks[ev]
        for g in groups:
            g["hooks"] = [h for h in g.get("hooks", []) if not is_ours(h.get("command"))]
        hooks[ev] = [g for g in groups if g.get("hooks")]
        if not hooks[ev]:
            del hooks[ev]
    if not hooks:
        s.pop("hooks", None)
    prev = s.get("statusLine")
    if isinstance(prev, dict) and is_ours(prev.get("command")):
        original = os.path.join(codesaver_dir, "statusline-original.json")
        try:
            with open(original, encoding="utf-8") as f:
                s["statusLine"] = json.load(f)
        except (OSError, json.JSONDecodeError):
            del s["statusLine"]
    return s


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--dry-run", action="store_true", help="print the diff, change nothing")
    ap.add_argument("--uninstall", action="store_true", help="remove the wiring")
    ap.add_argument("--dev", action="store_true",
                    help="point the hooks at this checkout instead of copying the scripts")
    ap.add_argument("--python", default=None,
                    help="python3 to run the hook with (default: the python3 on PATH)")
    ap.add_argument("--settings", default=os.path.expanduser("~/.claude/settings.json"),
                    help=argparse.SUPPRESS)  # tests point this at a copy
    a = ap.parse_args()

    claude_dir = os.path.dirname(os.path.abspath(a.settings))
    codesaver_dir = os.path.join(claude_dir, "codesaver")
    bin_dir = os.path.join(codesaver_dir, "bin")
    before = load(a.settings)

    side = {}
    if a.uninstall:
        after = unwire(before, codesaver_dir)
    else:
        python = a.python or shutil.which("python3") or sys.executable
        if a.dry_run:
            hook_path, wrapper_path = (
                (os.path.join(HERE, HOOK), os.path.join(HERE, WRAPPER)) if a.dev
                else (os.path.join(bin_dir, HOOK), os.path.join(bin_dir, WRAPPER)))
        else:
            hook_path, wrapper_path = install_scripts(bin_dir, a.dev)
        after, side = wire(before, hook_path, wrapper_path, python, codesaver_dir)

    old, new = dump(before), dump(after)
    diff = "".join(difflib.unified_diff(
        old.splitlines(True), new.splitlines(True),
        fromfile=a.settings, tofile=a.settings + " (new)"))
    if old == new and not side:
        print("already " + ("clean" if a.uninstall else "wired") + f": {a.settings}")
        return
    if a.dry_run:
        sys.stdout.write(diff or "(no change)\n")
        for p in side:
            print(f"would write {p}")
        return
    for p, text in side.items():
        write_atomic(p, text, mode=0o755 if p.endswith(".sh") else None)
    if os.path.exists(a.settings):
        backup = f"{a.settings}.bak-widgets-{time.strftime('%Y%m%d-%H%M%S')}"
        if os.path.exists(backup):          # two runs in one second
            backup += f".{os.getpid()}"
        shutil.copyfile(a.settings, backup)
        print(f"backup: {backup}")
    write_atomic(a.settings, new)
    if a.uninstall:
        shutil.rmtree(bin_dir, ignore_errors=True)
        print(f"unwired: {a.settings}")
        print("session state files stay in " + os.path.join(codesaver_dir, "sessions"))
    else:
        print(f"wired: {a.settings}")
        print(f"hooks -> {hook_path}")
        print(f"statusline -> {wrapper_path}")
        if any(p.endswith("statusline-passthrough.sh") for p in side):
            print("previous statusline kept, passed through by the wrapper")
        print("Claude Code reloads settings on its next start; the widgets need "
              "the feeds daemon (Auto-refresh toggle in CodeSaver.app).")


if __name__ == "__main__":
    main()
func activeDisplays() -> [CGDirectDisplayID] {
    var ids = [CGDirectDisplayID](repeating: 0, count: 16)
    var count: UInt32 = 0
    CGGetActiveDisplayList(UInt32(ids.count), &ids, &count)
    return count > 0 ? Array(ids.prefix(Int(count))) : [CGMainDisplayID()]
}

/// Corners the Dock has bound to "Start Screen Saver" (wvous value 5),
/// as global CG points. Re-read occasionally in case the user reconfigures.
func saverHotCorners() -> [CGPoint] {
    guard let dock = UserDefaults(suiteName: "com.apple.dock") else { return [] }
    var corners: [CGPoint] = []
    for id in activeDisplays() {
        let b = CGDisplayBounds(id)
        let map: [(String, CGPoint)] = [
            ("wvous-tl-corner", CGPoint(x: b.minX, y: b.minY)),
            ("wvous-tr-corner", CGPoint(x: b.maxX, y: b.minY)),
            ("wvous-bl-corner", CGPoint(x: b.minX, y: b.maxY)),
            ("wvous-br-corner", CGPoint(x: b.maxX, y: b.maxY)),
        ]
        for (key, point) in map where dock.integer(forKey: key) == 5 {
            corners.append(point)
        }
    }
    return corners
}

// MARK: - Custom corners (CodeSaver's own trigger)

/// The agent's config domain. Deployed, this process IS
/// refuses UserDefaults(suiteName:) matching your own bundle ID — reads
/// silently return zero. There the domain is simply .standard; the
/// suite-name path covers the bare build/ binary (no bundle ID).
func igniterDefaults() -> UserDefaults? {
        return .standard
    }
}

/// The Screen Recording grant is keyed on code identity — the installed
/// LaunchAgent bundle's, which the bare build/ binary does not share (TCC
/// attributes a shell-launched binary to its responsible process, usually
/// the terminal). CLI diagnostics say so, or a preflight answer from build/
/// reads as the agent's and sends the user re-granting a permission it has.
func identityCaveat() -> String? {
    return "   ^ for THIS binary's identity, not the installed agent's (TCC keys the grant on code\n"
        + "     identity). The agent's own verdict is every 'capture denied' line in\n"
        + "     ~/Library/Logs/CodeSaver/igniter.log; its grant is 'CodeSaver Igniter' under\n"
        + "     System Settings → Privacy & Security → Screen Recording."
}

struct CustomCorner {
    var point: CGPoint         // global CG (top-left origin)
    var flags: CGEventFlags    // required modifiers (empty = none)
}

/// Decodes one corner config int: bit 0 = armed, bit 1 = ⌘, bit 2 = ⌥,
/// bit 3 = ⌃, bit 4 = ⇧. 0 (the unset default) = off.
func cornerFlags(_ raw: Int) -> CGEventFlags? {
    guard raw & 1 == 1 else { return nil }
    var f = CGEventFlags()
    if raw & 2 != 0 { f.insert(.maskCommand) }
    if raw & 4 != 0 { f.insert(.maskAlternate) }
    if raw & 8 != 0 { f.insert(.maskControl) }
    if raw & 16 != 0 { f.insert(.maskShift) }
    return f
}

/// The config app's armed corners as global CG points. Every display
/// contributes its copy of an armed corner, but only where the cursor is
/// actually TRAPPED: on a multi-display desktop, a display corner that
/// opens onto a neighbor (a seam corner, or a shorter display's edge
/// meeting a taller one) is a thoroughfare the cursor crosses all day —
/// never a trigger.
func customCorners(_ defaults: UserDefaults?) -> [CustomCorner] {
    guard let d = defaults else { return [] }
    let wanted: [(key: String, ix: CGFloat, iy: CGFloat)] = [
        ("cornerTL", 1, 1), ("cornerTR", -1, 1),
        ("cornerBL", 1, -1), ("cornerBR", -1, -1),
    ]
    let bounds = activeDisplays().map { CGDisplayBounds($0) }
    var out: [CustomCorner] = []
    for w in wanted {
        guard let flags = cornerFlags(d.integer(forKey: w.key)) else { continue }
        for b in bounds {
            let cx = w.ix > 0 ? b.minX : b.maxX
            let cy = w.iy > 0 ? b.minY : b.maxY
            // Escape probes just outside the two edges meeting at this
            // corner: if either lands on another display, the cursor can
            // slide past — not a corner it can be pinned into.
            let escH = CGPoint(x: cx - w.ix * 3, y: cy + w.iy * 3)
            let escV = CGPoint(x: cx + w.ix * 3, y: cy - w.iy * 3)
            if bounds.contains(where: { $0.contains(escH) || $0.contains(escV) }) {
                continue
            }
            out.append(CustomCorner(point: CGPoint(x: cx, y: cy), flags: flags))
        }
    }
    return out
}
/// The per-display half of `captureDisplays`, on a queue of our own.
private func captureListedDisplays(_ content: SCShareableContent,
                                   completion: @escaping ([CGDirectDisplayID: CGImage], String?) -> Void) {
    // An empty display list is what the lock screen looks like — not an
    // error, and `captureImage` is never even called.
    let why = content.displays.isEmpty ? "shareable content lists no displays" : nil
    var result: [CGDirectDisplayID: CGImage] = [:]
    let lock = NSLock()
    let group = DispatchGroup()
    for display in content.displays {
        group.enter()
        let store: (CGImage?) -> Void = { image in
            if let image {
                lock.lock()
                result[display.displayID] = image
                lock.unlock()
            }
            group.leave()
        }
        if #available(macOS 15.2, *) {
            let balance = rectCaptureLeaks(on: display.displayID)
            SCScreenshotManager.captureImage(in: CGDisplayBounds(display.displayID)) { image, _ in
                // macOS 26.6: this form's completion block hands the CGImage
                // over at +1 and never releases it, so every capture leaks a
                // full-display IOSurface — charged to WindowServer, not to us.
                // Balance it, but only when the probe below has seen the leak
                // on this OS, so a fixed OS can't be over-released. Full story
                // at "captureImage(in:) leak probe".
                if balance, let image { Unmanaged.passUnretained(image).release() }
                store(image)
            }
        } else {
            let config = SCStreamConfiguration()
            let mode = CGDisplayCopyDisplayMode(display.displayID)
            config.width = mode.map(\.pixelWidth) ?? display.width
            config.height = mode.map(\.pixelHeight) ?? display.height
            config.showsCursor = false
            SCScreenshotManager.captureImage(
                contentFilter: SCContentFilter(display: display, excludingWindows: []),
                configuration: config
            ) { image, _ in store(image) }
        }
    }
    group.notify(queue: .main) {
        completion(result, result.isEmpty
            ? (why ?? "\(content.displays.count) display(s) listed, every capture came back nil")
            : nil)
    }
}


// MARK: - captureImage(in:) leak probe
//
// Found 2026-09-05 on macOS 26.6.2 (25G83), chasing "WindowServer uses 16 GB":
//
//   • WindowServer's footprint was 13 GB of "Owned physical footprint
//     (unmapped)": 435 IOSurfaces named "SL.205:CaptureSurface", 3456x2234
//     BGRA, 29.5 MiB each — one per rect-form capture this agent had taken in
//     three days. WindowServer creates every ScreenCaptureKit screenshot
//     surface and stays its memory-ledger owner, so a client that leaks
//     screenshots inflates WindowServer while its own footprint sits at
//     ~5 MB. Restarting this agent dropped WindowServer to 2.8 GB instantly.
//     (The hundreds of "Packages Display N Shield" windows people blame are a
//     separate, byte-sized leak — five per display sleep — a red herring.)
//   • `leaks` on a 30-line reproducer: the CGImage is a ROOT LEAK, retain
//     count 1, no referrers, owning CGDataProvider → IOSurface. Disassembly of
//     __60+[SCScreenshotManager captureImageInRect:completionHandler:]_block_invoke:
//     bl SLSDisplayCreateImage (SkyLight, returns +1) → mov x1, x0 → tear
//     down the frame → braa into the completion handler. A tail call: nothing
//     runs after the handler, so nothing can release. The nil-handler path
//     returns without releasing either.
//   • dtrace on every retain/release of that pointer: SkyLight balances its
//     own array bookkeeping and returns +1 correctly; the Swift handler
//     thunk's retain/release pair is balanced; nobody touches it afterwards.
//     The filter form (captureImageWithFilter:configuration: — an XPC round
//     trip to replayd, composited from each window's own surface, hence no
//     shadows) calls CFRelease right after its handler returns. Two unrelated
//     implementations; only the rect one — the shadowed one we want — has the
//     bug.
//   • Reported to Apple via Feedback Assistant (reproducer, evidence and the
//
// So the fix on our side is exactly one release — the +1 the block owes —
// done from inside the handler. It is gated by a runtime probe rather than an
// OS-version check: the day Apple adds the missing release, an unconditional
// extra one would be an over-release and a crash. The probe costs one capture
// and, on an affected OS, one leaked surface per process lifetime.
//
// The probe waits on a semaphore, so it must not run on ScreenCaptureKit's own
// callback queue: the rect capture is delivered through that queue and, when
// it is blocked, comes back nil (no error) after ~5 s — an "inconclusive"
// probe every time. `captureDisplays` hops to a global queue before calling
// it; keep it that way.
// MARK: - Watcher

final class Igniter {
    private let defaults = igniterDefaults()
    /// Idle seconds before the idle-kind capture is taken. Well under any
    /// sane system saver timeout, so the manifest is ready when macOS fires.
    private var captureAfterIdle: Double {
        let v = defaults?.double(forKey: "captureAfterIdle") ?? 0
        return v == 0 ? 20 : max(5, v)
    }
    private let cornerProximity: CGFloat = 60

    /// Custom idle timeout (seconds; 0/absent = off): CodeSaver starts the
    /// saver ITSELF after this much inactivity — capture at the moment of
    /// launch, proactive scouting off. The user disables macOS's own saver
    /// timeout in this mode. Clamped ≥10 s against defaults-write typos
    /// (10 is also the hands-on test value, set via defaults write — the
    /// app UI's smallest offering stays 1 minute).
    private var customIdleTimeout: Double? {
        let v = defaults?.integer(forKey: "idleTimeout") ?? 0
        return v > 0 ? Double(max(10, v)) : nil
    }
    /// Proactive idle captures refresh on this cadence — an "idle" desktop
    /// still drifts (notifications, finishing builds, ticking widgets).
    private let idleRefreshEvery: Double = 300

    private var idleCaptured = false
    private var idleLaunched = false
    private var lastIdleCapture = Date.distantPast
    private var cornerCaptured = false
    private var capturing = false
    /// The capture in flight: when it started, what kind, whether a launch
    /// waits on it — and its generation, so a completion that finally
    /// arrives after the watchdog gave up on it can be told from the next
    /// capture's own.
    private var captureStarted = Date.distantPast
    private var captureKind = ""
    private var captureLaunches = false
    private var captureGeneration = 0
    /// How long a capture may stay unanswered. A healthy shot takes ~0.3 s
    /// and the leak probe's own bound is 15 s; past 30 s ScreenCaptureKit
    /// has lost the callback, and `capturing` latched forever would mean
    /// no capture ever again and every corner hit queued for good.
    private static let captureWatchdog: TimeInterval = 30
    private var lastCornerCapture = Date.distantPast
    private var corners: [CGPoint] = []
    private var custom: [CustomCorner] = []
    private var cornersReadAt = Date.distantPast
    private var gesture = CornerGesture()
    /// The recognizer's own clock; runs only while a custom corner is armed.
    private var gestureTimer: Timer?
    private var lastLaunch = Date.distantPast
    private var pendingLaunch = false
    private var saverWasRunning = false
    /// Stamped when the saver leaves the screen. A dismissal can leave no
    /// HID trace (Touch ID unlock; the secure-input lock screen swallows
    /// the wake event), so by the raw HID clock the user still looks
    /// "away" — and a corner-launched saver watched past idleTimeout
    /// would relaunch on the very next tick.
    private var lastSaverExit = Date.distantPast
    /// After a failed capture (permission denied), don't keep re-triggering
    /// the TCC prompt — retry occasionally.
    private var captureBackoffUntil = Date.distantPast

    init() {
        deleteManifest()   // never trust leftovers from a previous session
        Timer.scheduledTimer(withTimeInterval: 0.2, repeats: true) { [weak self] _ in
            self?.tick()
        }
    }

    private func tick() {
        if capturing, Date().timeIntervalSince(captureStarted) > Self.captureWatchdog {
            captureWatchdogFired()
        }
        // After a permission-denied capture, captures back off — but corner
        // HITS keep working (the saver just starts without a boom).
        let captureOK = Date() >= captureBackoffUntil
        let saverUp = saverIsRunning()
        if saverWasRunning, !saverUp { lastSaverExit = Date() }
        saverWasRunning = saverUp
        // Idle as this agent scores it: a saver dismissal ends the idle
        // episode even when it left no HID trace, so every launch decision
        // starts a fresh clock from the moment the saver went away.
        let idle = min(idleSeconds(), Date().timeIntervalSince(lastSaverExit))
    private func capture(kind: String, then: (() -> Void)? = nil) {
        capturing = true
        captureStarted = Date()
        captureKind = kind
        captureLaunches = then != nil
        captureGeneration &+= 1
        let generation = captureGeneration
        let mouse = mouseCG()
        captureDisplays { [weak self] images, why in
            // The watchdog gave up on this shot and may have started another:
            // a late answer owns nothing any more — not the flags, not the
            // manifest (it would overwrite the newer capture's), not the
            // launch (already fired plainly, or dropped). Let the images go.
            guard let self, generation == self.captureGeneration, self.capturing else {
                igniterLog("\(kind) capture answered late (after the watchdog) — ignored")
                return
            }
            var userReturned = false
            // No images: write nothing (the saver then starts normally) —
            // but only ONE of the possible reasons deserves the long backoff.
            //  • Screen Recording denied: asked directly, without prompting
            //    (CGPreflightScreenCaptureAccess). Ten minutes before the
            //    next try, so the TCC prompt isn't spammed.
            //  • Lock screen: ScreenCaptureKit lists zero displays there.
            //    Nothing to capture and nothing wrong — no backoff at all.
            //    (Inferring "no permission" from the empty result used to
            //    poison the next ten minutes: every corner hit, even from
            //    the unlocked desktop, launched a boomless saver.)
            //  • Anything else is a transient SCK/replayd hiccup: retry
            //    almost at once.
            if images.isEmpty {
                // Whatever manifest is on disk predates this attempt: a
                // corner hit must not ride it — and it is a screenshot of
                // the desktop, so it must not outlive its owner flag either
                // (the return-cleanup only sweeps what a flag says is
                // there; drop the flag alone and the file is orphaned).
                // Delete it and forget the attempt outright, so the retry
                // is a real one: the idle gate re-opens the moment the
                // backoff passes instead of waiting out idleRefreshEvery
                // on a latch that was set before the shot came back.
                deleteManifest()
                self.idleCaptured = false
                self.cornerCaptured = false
                if kind == "corner" { self.lastCornerCapture = .distantPast }
                else { self.lastIdleCapture = .distantPast }
                let detail = why ?? "no detail"
                if !CGPreflightScreenCaptureAccess() {
                    igniterLog("\(kind) capture denied — no Screen Recording permission (\(detail)); backing off 10 min")
                    self.captureBackoffUntil = Date().addingTimeInterval(600)
                } else if screenIsLocked() {
                    igniterLog("\(kind) capture skipped — screen is locked, no desktop to capture (\(detail))")
                } else {
                    igniterLog("\(kind) capture empty — \(detail); retrying in 2 s")
                    self.captureBackoffUntil = Date().addingTimeInterval(2)
                }
            } else if kind == "idle", idleSeconds() < 1.0 {
                // The user returned during the shot's latency. The return-
                // cleanup already ran (nothing to delete then) and reset
                // idleCaptured — writing now would orphan a screenshot on
                // disk with nothing left to delete it. Drop the capture —
                // and the launch that was waiting on it: an idle-timeout
                // launch decided 300 ms ago would otherwise start the saver
                // over a user who is back at the keyboard. (A corner hit
                // that landed mid-capture still rides below: that one was
                // the user's own hand.)
                userReturned = true
            } else {
                writeManifest(kind: kind, mouse: mouse, captures: images)
                // Mark what's on disk so the return-cleanup knows to sweep
                // it — including custom-timeout launches, whose capture
                // doesn't come through the proactive path.
                if kind == "corner" { self.cornerCaptured = true }
                else { self.idleCaptured = true }
            }
            self.capturing = false
            // A hit that landed while this capture was in flight rides it:
            // the capture (fresh either way) is on disk before the launch.
            if self.pendingLaunch == true {
                self.pendingLaunch = false
                self.launchSaver("\(kind): hit landed mid-capture, riding it")
            }
            if userReturned {
                if then != nil {
                    igniterLog("\(kind) launch dropped — the user returned during the capture")
                }
            } else {
                then?()
            }
        }
    }
}
#!/bin/zsh
# Install the CodeSaver igniter LaunchAgent — the capture scout that keeps a
# fresh desktop screenshot ready for the saver's boom intro. Usage:
#   ./helper/install.sh              install + start
#   ./helper/install.sh uninstall    stop + remove
#
# The binary is wrapped in a minimal signed .app bundle with a fixed bundle
# identifier: TCC ties the Screen Recording grant to "identifier + team", so
# the permission survives rebuilds. A bare ad-hoc binary re-prompts on every
# rebuild because its only identity is its own hash.
set -euo pipefail
cd "$(dirname "$0")/.."

LOG_DIR="$HOME/Library/Logs/CodeSaver"
APP_DIR="$HOME/Library/Application Support/CodeSaver/CodeSaverIgniter.app"
BIN="$APP_DIR/Contents/MacOS/codesaver-igniter"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
UID_NUM=$(id -u)

if [[ ${1:-} == uninstall ]]; then
  launchctl bootout "gui/$UID_NUM/$LABEL" 2>/dev/null || true
  rm -f "$PLIST"
  rm -rf "$APP_DIR"
  echo "── igniter removed"
  exit 0
fi

[[ -f build/codesaver-igniter ]] || { echo "run ./build.sh first"; exit 1 }

# Signing identity: same detection as appex/install.sh. A real certificate
# gives TCC a stable designated requirement; ad-hoc falls back to per-build
# identity (the permission will re-prompt after rebuilds).
SIGN_ID="${SIGN_ID:-Apple Development}"
if ! security find-certificate -c "$SIGN_ID" >/dev/null 2>&1; then
  echo "── warning: no '$SIGN_ID' certificate — ad-hoc signing (TCC grant won't survive rebuilds)"
  SIGN_ID="-"
fi

# Not loaded yet (first install) is the normal failure here; keep its message
# in case the job is genuinely stuck instead.
BOOTOUT_ERR=$(launchctl bootout "gui/$UID_NUM/$LABEL" 2>&1 >/dev/null || true)
# launchd tears the old instance down asynchronously; bootstrapping while
# that is still in flight fails with "Bootstrap failed: 5: Input/output
# error" and leaves NO igniter running (the only saver trigger). Wait it out
# — past launchd's default 20 s ExitTimeOut — and refuse to go on while the
# old job is still loaded: every bootstrap below would fail, yet `launchctl
# print` would still answer for the OLD instance and read as success.
OLD_GONE=0
for _ in {1..50}; do
  launchctl print "gui/$UID_NUM/$LABEL" >/dev/null 2>&1 || { OLD_GONE=1; break }
  sleep 0.5
done
if (( ! OLD_GONE )); then
  echo "── the previous igniter is still loaded after 25 s; not replacing it"
  [[ -n $BOOTOUT_ERR ]] && echo "   launchctl bootout: $BOOTOUT_ERR"
  echo "   stop it, then re-run:  launchctl bootout gui/$UID_NUM/$LABEL"
  exit 1
fi

mkdir -p "$APP_DIR/Contents/MacOS" "$LOG_DIR"
cat > "$APP_DIR/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>$LABEL</string>
    <key>CFBundleName</key><string>CodeSaver Igniter</string>
    <key>CFBundleExecutable</key><string>codesaver-igniter</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>LSUIElement</key><true/>
</dict>
</plist>
PLIST
cp build/codesaver-igniter "$BIN"
codesign --force --sign "$SIGN_ID" --identifier "$LABEL" "$APP_DIR"

cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$LABEL</string>
    <key>ProgramArguments</key><array><string>$BIN</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>$LOG_DIR/igniter.log</string>
    <key>StandardErrorPath</key><string>$LOG_DIR/igniter.log</string>
</dict>
</plist>
PLIST
# Success means OUR bootstrap was accepted — not merely that some job with
# this label is loaded (see the wait above). Keep the last error to show.
BOOTSTRAPPED=0
BOOTSTRAP_ERR=""
for attempt in {1..5}; do
  if BOOTSTRAP_ERR=$(launchctl bootstrap "gui/$UID_NUM" "$PLIST" 2>&1); then
    BOOTSTRAPPED=1
    break
  fi
  sleep 1
done
if (( ! BOOTSTRAPPED )); then
  echo "── igniter did NOT start: ${BOOTSTRAP_ERR:-bootstrap failed}"
  echo "   re-run:  launchctl bootstrap gui/$UID_NUM $PLIST"
  exit 1
fi
launchctl print "gui/$UID_NUM/$LABEL" >/dev/null 2>&1 \
  || { echo "── igniter bootstrapped but is not loaded: launchctl bootstrap gui/$UID_NUM $PLIST"; exit 1 }

echo "── igniter installed and running (signed: $SIGN_ID)"
echo "   launch decisions + capture failures: $LOG_DIR/igniter.log"
echo
echo "   macOS is the trigger: set System Settings → Lock Screen →"
echo "   'Start Screen Saver when inactive' to taste, and/or a hot corner."
echo "   Idle triggers play a 5s pre-animation; hot corners detonate at once."
echo "   Grant 'CodeSaver Igniter' Screen Recording permission when prompted —"
echo "   with a real signing certificate that grant now survives rebuilds."
echo "   Capture happens after this much idle (default 20s):"
echo "     defaults write $LABEL captureAfterIdle -float 20"
#!/bin/zsh
# Regenerate the sample code CodeSaver types before it has anyone's own:
#   ./scripts/make-sample-corpus.sh
#
# Writes appex/CodeSaverExtension/Resources/sample-corpus.bin + sample-corpus-
# index.json, the same pair CodeSaver.app writes into the app-group container
# (blocks packed back to back, a JSON index of [offset, length] per key, the
# index's last byte = the bin's last byte), so the saver reads it with the
# reader it already has. Both the saver and the app's hero fall back to it
# whenever the container holds no corpus; a user's own code always wins.
#
# The text is CodeSaver's own MIT-licensed source — Swift, Python and shell —
# cut into ~90-line blocks, never the whole tree: past SHARE bytes a file
# keeps evenly spaced blocks worth √(size·SHARE), which holds the bundle near
# 250 KB and lets the saver's long files show the most without a 5,000-line
# view crowding out the short ones (the writers pick blocks uniformly). Each
# file is its own index key, so the reader's per-repo share cap never bites.
# inside every download and types on strangers' screens.
set -euo pipefail
cd "$(dirname "$0")/.."

OUT=appex/CodeSaverExtension/Resources
SHARE=${SHARE:-6000}

exec python3 -I - "$OUT" "$SHARE" <<'PY'
import json, os, re, subprocess, sys, unicodedata

out_dir, share = sys.argv[1], int(sys.argv[2])

# Tracked files plus new ones not yet added, minus anything .gitignore'd —
# build products, SourcePackages checkouts and scratch never get in.
listed = subprocess.run(
    ["git", "ls-files", "-co", "--exclude-standard", "--", "*.swift", "*.py", "*.sh"],
    capture_output=True, text=True, check=True).stdout.splitlines()

# Whole files left out: the feeds daemon and its checks speak to one
# screen should be typing.
EXCLUDE = {"appex/CodeSaver/FeedsService.swift", "Sources/FeedsCheck.swift"}

# A line matching any of these is dropped outright (the gap is invisible in
# a 20-line typed window): the author's name and handle, home-directory and
# private-tool paths, email addresses, the signing team.
PRIVATE = re.compile(
    re.IGNORECASE)
# Never sample a file holding key material, or anything token-shaped.
SECRET = re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----|\bghp_[A-Za-z0-9]{20,}"
                    r"|\bgithub_pat_\w{20,}|\bsk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}")

CHUNK, CHUNK_MIN, CHUNK_MAX = 90, 60, 120
MAX_LINE = 200   # what CorpusIngest clips to

def clean(text):
    text = unicodedata.normalize("NFC", text).replace("\r\n", "\n").replace("\r", "\n")
    lines = []
    for raw in text.split("\n"):
        line = "".join(c for c in raw.expandtabs(4)
                       if c == " " or c in "‌‍"
                       or unicodedata.category(c)[0] != "C").rstrip()
        if SECRET.search(line):
            return None
        if PRIVATE.search(line):
            continue
        lines.append(line[:MAX_LINE])
    return lines

def chunks(lines):
    """~CHUNK-line blocks, cut at a blank line when one falls in range."""
    out, i = [], 0
    while i < len(lines):
        end = min(len(lines), i + CHUNK)
        if end < len(lines):
            blanks = [j for j in range(i + CHUNK_MIN, min(len(lines), i + CHUNK_MAX))
                      if not lines[j].strip()]
            if blanks:
                end = min(blanks, key=lambda j: abs(j - (i + CHUNK)))
        block = lines[i:end]
        while block and not block[0].strip(): block.pop(0)
        while block and not block[-1].strip(): block.pop()
        if sum(1 for l in block if l.strip()) >= 8:
            out.append(("\n".join(block) + "\n").encode())
        i = end
    return out
blob, index, langs = bytearray(), {}, {}
for path in sorted(set(listed) - EXCLUDE):
    try:
        with open(path, encoding="utf-8") as f:
            lines = clean(f.read())
    except (OSError, UnicodeDecodeError):
        continue
    if not lines:
        continue
    blocks = chunks(lines)
    total = sum(map(len, blocks))
    budget = (total * share) ** 0.5   # past SHARE bytes, a file keeps √(size·SHARE)
    if total > budget and blocks:
        # Evenly spaced across the file, so a long one shows its range.
        keep = max(1, round(len(blocks) * budget / total))
        step = len(blocks) / keep
        blocks = [blocks[int(k * step + step / 2)] for k in range(keep)]
    for b in blocks:
        index.setdefault(path, []).append([len(blob), len(b)])
        blob += b
        ext = path.rsplit(".", 1)[-1]
        langs[ext] = langs.get(ext, 0) + len(b)

os.makedirs(out_dir, exist_ok=True)
with open(os.path.join(out_dir, "sample-corpus.bin"), "wb") as f:
    f.write(blob)
with open(os.path.join(out_dir, "sample-corpus-index.json"), "w") as f:
    json.dump(index, f, sort_keys=True, separators=(",", ":"))

print(f"sample corpus: {len(index)} files, {sum(map(len, index.values()))} blocks, "
      f"{len(blob) / 1024:.0f} KB (" +
      ", ".join(f"{k} {v / 1024:.0f} KB" for k, v in sorted(langs.items())) + f") → {out_dir}")
PY
