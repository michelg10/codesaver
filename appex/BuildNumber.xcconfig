CURRENT_PROJECT_VERSION = 261010.0000

// The version people see — CFBundleShortVersionString in both Info.plists,
// and the tag scripts/release.sh publishes. Set here only: every target
// inherits it. (The CodeSaver scheme's pre-action restamps the line above
// on every build and leaves the rest of this file alone.)
MARKETING_VERSION = 1.0.0

// This machine's own settings, if it has any: optional and gitignored (see
// Local.xcconfig.example). Last, so it can add to anything above.
#include? "Local.xcconfig"
